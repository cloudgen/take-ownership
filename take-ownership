app_main_menu_run_named() {
    _verb="${1-}"
    _a="${2-}"
    _b="${3-}"
    : "${APP_NAME:=take-ownership}"

    case "${_verb}" in
        action)
            TO_PATH="${_a}"
            TO_OWNERSHIP="${_b}"
