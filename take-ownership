# =============================================================================
# app_main() - Main entrypoint and command dispatcher
# =============================================================================
#
# GENERAL PURPOSE:
# Single dispatcher for take-ownership (specialized from selfmanaged + domain).
# Empty argv after flag parse: TTY menu; off-TTY Type O install-ensure; --json JSON help.
#
# ALIGNMENT:
# - requirement-shell-cli-interface.md
# - requirement-shell-cli-zero-arguments.md
# - requirement-shell-cli-default-interaction.md
# - requirement-take-ownership-ops.md
#
# !!! DO NOT MODIFY OR SIMPLIFY THIS FUNCTION !!!
#
# Last updated: 2026-08-30
# =============================================================================
app_main() {
    COMMAND=""
    : "${QUIET:=0}"
    : "${JSON:=0}"
    : "${DEBUG:=0}"
    : "${FORCE:=0}"
    : "${FORCE_REINSTALL:=0}"
    : "${FORCE_GLOBAL:=0}"
    : "${SUBMIT_PURPOSE:=}"
    : "${SUBMIT_ACTION:=add}"
    : "${SUBMIT_ACTION_EXPLICIT:=0}"
    : "${TO_PATH:=}"
    : "${TO_OWNERSHIP:=}"
    : "${TO_FLAG_ORDER_OK:=1}"
    : "${TO_SEEN_PATH:=0}"
    : "${TO_SEEN_OWNERSHIP:=0}"
    : "${USERNAME:=unknown}"
    : "${HOME:=/tmp}"
    : "${APP_NAME:=take-ownership}"

    # Cache folder + persistence (requirement-shell-cli-storage).
    # Linux: shm leaf, then /tmp leaf, then ${HOME}/.cache leaf.
    # A missed tier is silent. Export TMPDIR so mktemp lands in the cache leaf.
    EFFECTIVE_STORAGE_DIR=$(util_resolve_storage)
    STORAGE_DIR=$(util_fallback_cache_dir)
    PERSISTENT_STORAGE_DIR=$(util_resolve_persistent_storage)
    export EFFECTIVE_STORAGE_DIR STORAGE_DIR PERSISTENT_STORAGE_DIR
    export TMPDIR="${EFFECTIVE_STORAGE_DIR}"

    # Empty argv = no command token after flag parse.
    # TTY → menu. Off-TTY → Type O ensure. --json no-command → JSON help.
    _saw_command=0
    _domain_arg=""
    _domain_arg2=""
    _menu_pick=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --quiet|-q) QUIET=1 ;;
            --json)     JSON=1; QUIET=1 ;;
            --debug)    DEBUG=1 ;;
            --force)    FORCE=1; FORCE_REINSTALL=1 ;;
            --global)   FORCE_GLOBAL=1; export FORCE_GLOBAL ;;
            --path)
                if [ $# -lt 2 ]; then
                    out_die "--path requires an absolute folder"
                fi
                if [ "${TO_SEEN_OWNERSHIP}" -eq 1 ]; then
                    TO_FLAG_ORDER_OK=0
                    export TO_FLAG_ORDER_OK
                fi
                TO_PATH="$2"
                TO_SEEN_PATH=1
                export TO_PATH TO_SEEN_PATH
                shift
                ;;
            --ownership)
                if [ $# -lt 2 ]; then
                    out_die "--ownership requires user:group"
                fi
                if [ "${TO_SEEN_PATH}" -ne 1 ]; then
                    TO_FLAG_ORDER_OK=0
                    export TO_FLAG_ORDER_OK
                fi
                TO_OWNERSHIP="$2"
                TO_SEEN_OWNERSHIP=1
                export TO_OWNERSHIP TO_SEEN_OWNERSHIP
                shift
                ;;
            --purpose)
                if [ $# -lt 2 ]; then
                    out_die "--purpose requires TEXT"
                fi
                SUBMIT_PURPOSE="$2"
                export SUBMIT_PURPOSE
                shift
                ;;
            --update)
                SUBMIT_ACTION="update"
                SUBMIT_ACTION_EXPLICIT=1
                export SUBMIT_ACTION SUBMIT_ACTION_EXPLICIT
                ;;
            --add)
                SUBMIT_ACTION="add"
                SUBMIT_ACTION_EXPLICIT=1
                export SUBMIT_ACTION SUBMIT_ACTION_EXPLICIT
                ;;
            version|about|help|install|uninstall|self-uninstall|self-update|version-check|where-is-me|list-folders|action|print-sudoers|print-sudoers-install-script|remove-project-sudoers|generate-sudoer-request|generate-sudoer-json|submit-sudoer-request|menu|main)
                _saw_command=1
                if [ "${COMMAND}" = "menu" ] || [ "${COMMAND}" = "main" ]; then
                    if [ -z "${_menu_pick}" ]; then
                        _menu_pick="$1"
                    elif [ -z "${_domain_arg}" ]; then
                        _domain_arg="$1"
                    elif [ -z "${_domain_arg2}" ]; then
                        _domain_arg2="$1"
                    else
                        out_die "Unexpected argument: $1. See '${APP_NAME} help'."
                    fi
                else
                    COMMAND="$1"
                fi
                ;;
            *)
                if [ "${COMMAND}" = "print-sudoers" ] \
                    || [ "${COMMAND}" = "print-sudoers-install-script" ] \
                    || [ "${COMMAND}" = "remove-project-sudoers" ] \
                    || [ "${COMMAND}" = "generate-sudoer-request" ] \
                    || [ "${COMMAND}" = "generate-sudoer-json" ] \
                    || [ "${COMMAND}" = "submit-sudoer-request" ]; then
                    if [ -z "${_domain_arg}" ]; then
                        _domain_arg="$1"
                    else
                        out_die "Unexpected argument: $1. See '${APP_NAME} help'."
                    fi
                elif [ "${COMMAND}" = "menu" ] || [ "${COMMAND}" = "main" ]; then
                    if [ -z "${_menu_pick}" ]; then
                        _menu_pick="$1"
                    elif [ -z "${_domain_arg}" ]; then
                        _domain_arg="$1"
                    elif [ -z "${_domain_arg2}" ]; then
                        _domain_arg2="$1"
                    else
                        out_die "Unexpected argument: $1. See '${APP_NAME} help'."
                    fi
                else
                    out_die "Unknown command or flag: $1. See '${APP_NAME} help'."
                fi
                ;;
        esac
        shift
    done

    if [ "${_saw_command}" -eq 0 ]; then
        if [ "${JSON}" -eq 1 ]; then
            COMMAND=help
        elif [ "${TTY}" -eq 1 ]; then
            COMMAND=menu
        else
            COMMAND=ensure
        fi
    fi

    out_debug "dispatch command=${COMMAND} quiet=${QUIET} json=${JSON} force=${FORCE} force_global=${FORCE_GLOBAL} path=${TO_PATH} ownership=${TO_OWNERSHIP}"

    case "${COMMAND}" in
        version)      app_version ;;
        about)        app_about ;;
        install)      inst_perform_install ;;
        uninstall|self-uninstall) inst_self_uninstall ;;
        self-update)  inst_self_update ;;
        version-check) ver_check ;;
        ensure)
            inst_empty_argv_ensure
            exit $?
            ;;
        where-is-me)  app_where_is_me ;;
        list-folders) to_list_folders ;;
        action)       to_action ;;
        print-sudoers) to_print_sudoers "${_domain_arg}" ;;
        print-sudoers-install-script) to_print_sudoers_install_script "${_domain_arg}" ;;
        remove-project-sudoers) to_remove_project_sudoers "${_domain_arg}" ;;
        generate-sudoer-request|generate-sudoer-json) to_generate_sudoer_request "${_domain_arg}" ;;
        submit-sudoer-request) to_submit_sudoer_request "${_domain_arg}" ;;
        menu|main)    app_main_menu "${_menu_pick}" "${_domain_arg}" "${_domain_arg2}" ;;
        help|*)       app_help ;;
    esac
}

