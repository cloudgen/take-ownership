            to_action
            ;;
        generate-sudoer-request|generate-sudoer-json)
            COMMAND="${_verb}"
            to_generate_sudoer_request "${_a}"
            ;;
        submit-sudoer-request)
            to_submit_sudoer_request "${_a}"
            ;;
        print-sudoers)
            to_print_sudoers "${_a}"
            ;;
        print-sudoers-install-script)
            to_print_sudoers_install_script "${_a}"
            ;;
        remove-project-sudoers)
            to_remove_project_sudoers "${_a}"
            ;;
        install)
            inst_perform_install
            ;;
        version)
            app_version
            ;;
        about)
            app_about
            ;;
        version-check)
            ver_check
            ;;
        self-update)
            inst_self_update
            ;;
        self-uninstall|uninstall)
            inst_self_uninstall
            ;;
        where-is-me)
            app_where_is_me
            ;;
        list-folders)
            to_list_folders
            ;;
        help)
            app_help
            ;;
        menu|main)
            ;;
        *)
