# =============================================================================
# app_main_menu_layer_loop() - One submenu until Back or a finished leaf
# =============================================================================
#
# GENERAL PURPOSE:
# 0, back, q, an empty line, or EOF returns to the front board. A listed
# choice runs, then the caller redisplays the front board. An unknown token
# warns and reprints this layer. 9 does not leave the program.
#
# ALIGNMENT:
# - requirement-shell-cli-default-interaction.md
#
# Last updated: 2026-09-30
# =============================================================================
app_main_menu_layer_loop() {
    : "${APP_NAME:=take-ownership}"
    : "${_menu_json:=0}"
    : "${_menu_quiet:=0}"
    _layer="${1-}"
    _argv_a="${2-}"

    while true; do
        JSON=0
        QUIET=0
        export JSON QUIET
        case "${_layer}" in
            sudoers) app_main_menu_print_sudoers ;;
            self) app_main_menu_print_self ;;
            *) return 0 ;;
        esac
        if ! prompt_line "Choice"; then
            return 0
        fi
        _pick="${_prompt_line}"
        if [ -z "${_pick}" ]; then
            return 0
        fi
        case "${_pick}" in
            0|back|Back|BACK|q|Q)
                return 0
                ;;
        esac
        JSON="${_menu_json}"
        QUIET="${_menu_quiet}"
        export JSON QUIET
        case "${_layer}" in
            sudoers) app_main_menu_run_sudoers_pick "${_pick}" "${_argv_a}" ;;
            self) app_main_menu_run_self_pick "${_pick}" "${_argv_a}" ;;
            *) return 1 ;;
        esac
        if [ "$?" -eq 0 ]; then
            return 0
        fi
        JSON=0
        QUIET=0
        export JSON QUIET
        app_main_menu_warn_bad "${_pick}"
        _argv_a=""
    done
}

# =============================================================================
# app_main_menu() - Default interaction: TTY numbered tree / off-TTY help
# =============================================================================
#
# GENERAL PURPOSE:
# Empty argv, menu, and main. On a real terminal: ignore --json, show the
# front board, and return to it after a finished command. Off-TTY: help
# (JSON help when --json). Never hang. Off-TTY empty argv is Type O on the
# zero-argument requirement, not this function. sudoers and self-management
# are not live CLI commands.
#
# ALIGNMENT:
# - requirement-shell-cli-default-interaction.md
# - requirement-shell-interactive-vs-noninteractive.md
# - requirement-shell-cli-zero-arguments.md
#
# Last updated: 2026-09-30
# =============================================================================
app_main_menu() {
    : "${TTY:=0}"
    : "${JSON:=0}"
    : "${QUIET:=0}"
    : "${APP_NAME:=take-ownership}"
    _argv_pick="${1-}"
    _argv_a="${2-}"
    _argv_b="${3-}"

    if [ "${TTY}" -ne 1 ]; then
        _menu_quiet="${QUIET}"
        if [ "${JSON}" -ne 1 ]; then
            QUIET=0
        fi
        app_help
        QUIET="${_menu_quiet}"
        return 0
    fi

    _menu_json="${JSON}"
    _menu_quiet="${QUIET}"
    JSON=0
    QUIET=0
    export JSON QUIET

    while true; do
        JSON=0
        QUIET=0
        export JSON QUIET
        app_main_menu_print
        if [ -n "${_argv_pick}" ]; then
            _pick="${_argv_pick}"
            _argv_pick=""
        else
            if ! prompt_line "Choice"; then
                JSON="${_menu_json}"
                QUIET="${_menu_quiet}"
                export JSON QUIET
                return 0
            fi
            _pick="${_prompt_line}"
        fi
        if [ -z "${_pick}" ]; then
            JSON="${_menu_json}"
            QUIET="${_menu_quiet}"
            export JSON QUIET
            return 0
        fi
        case "${_pick}" in
            9|exit|quit|Exit|QUIT|EXIT|Quit)
                JSON="${_menu_json}"
                QUIET="${_menu_quiet}"
                export JSON QUIET
                return 0
                ;;
            7|sudoers)
                if app_main_menu_sudoers_hidden; then
                    app_main_menu_warn_bad "${_pick}"
                    _argv_a=""
                    _argv_b=""
                    continue
                fi
                app_main_menu_layer_loop sudoers "${_argv_a}"
                _argv_a=""
                _argv_b=""
                continue
                ;;
            8|self-management)
                app_main_menu_layer_loop self "${_argv_a}"
                _argv_a=""
                _argv_b=""
                continue
                ;;
        esac
        JSON="${_menu_json}"
        QUIET="${_menu_quiet}"
        export JSON QUIET
        if app_main_menu_run_front_pick "${_pick}" "${_argv_a}" "${_argv_b}"; then
            _argv_a=""
            _argv_b=""
            continue
        fi
        JSON=0
        QUIET=0
        export JSON QUIET
        app_main_menu_warn_bad "${_pick}"
        _argv_a=""
        _argv_b=""
    done
}

