# =============================================================================
# app_main_menu_run_pick() - Run one menu choice (number or verb)
# =============================================================================
#
# GENERAL PURPOSE:
# Map a numbered pick or verb token to a live operational handler. Missing
# required operands: prompt one field at a time, or print Next: and return.
# Returns 1 if the pick is not on the list (caller re-prompts).
#
# ALIGNMENT:
# - requirement-shell-cli-default-interaction.md
#
# Last updated: 2026-08-30
# =============================================================================
app_main_menu_run_pick() {
    _pick="${1-}"
    _a="${2-}"
    _b="${3-}"
    : "${APP_NAME:=take-ownership}"

    case "${_pick}" in
        1|action)
            TO_PATH="${_a}"
            TO_OWNERSHIP="${_b}"
            export TO_PATH TO_OWNERSHIP
            to_action
            ;;
        2|remove-project-sudoers)
            to_remove_project_sudoers "${_a}"
            ;;
        3|submit-sudoer-request)
            to_submit_sudoer_request "${_a}"
            ;;
        9|exit|quit|Exit|QUIT)
            ;;
        *)
            return 1
            ;;
    esac
    return 0
}

# =============================================================================
# app_main_menu() - Default interaction: TTY numbered menu / off-TTY help
# =============================================================================
#
# GENERAL PURPOSE:
# Empty argv, menu, and main. On a real terminal: ignore --json, show the
# numbered list, run one pick. Off-TTY: help (JSON help when --json). Never hang.
# Type N: empty argv MUST NOT install.
#
# ALIGNMENT:
# - requirement-shell-cli-default-interaction.md
# - requirement-shell-interactive-vs-noninteractive.md
# - requirement-shell-cli-zero-arguments.md
#
# Last updated: 2026-08-30
# =============================================================================
app_main_menu() {
    : "${TTY:=0}"
    : "${JSON:=0}"
    : "${QUIET:=0}"
    : "${APP_NAME:=take-ownership}"
    _argv_pick="${1-}"
    _argv_a="${2-}"
    _argv_b="${3-}"

    if [ "${TTY}" -ne 1 ]; then
        _menu_quiet="${QUIET}"
        if [ "${JSON}" -ne 1 ]; then
            QUIET=0
        fi
        app_help
        QUIET="${_menu_quiet}"
        return 0
    fi

    _menu_json="${JSON}"
    _menu_quiet="${QUIET}"
    JSON=0
    QUIET=0
    export JSON QUIET

    while true; do
        app_main_menu_print
        if [ -n "${_argv_pick}" ]; then
            _pick="${_argv_pick}"
            _argv_pick=""
        else
            if ! prompt_line "Choice"; then
                JSON="${_menu_json}"
                QUIET="${_menu_quiet}"
                export JSON QUIET
                return 0
            fi
            _pick="${_prompt_line}"
        fi
        case "${_pick}" in
            9|exit|quit|Exit|QUIT)
                JSON="${_menu_json}"
                QUIET="${_menu_quiet}"
                export JSON QUIET
                return 0
                ;;
        esac
        if app_main_menu_run_pick "${_pick}" "${_argv_a}" "${_argv_b}"; then
            JSON="${_menu_json}"
            QUIET="${_menu_quiet}"
            export JSON QUIET
            return 0
        fi
        out_warn "Not a menu choice. Type 1-3, 9 to leave, or a command name."
        out_info "Next: ${APP_NAME} menu"
        _argv_a=""
        _argv_b=""
    done
}

