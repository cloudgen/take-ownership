# =============================================================================
# app_about() - Diagnostics (local-only; no channel one-liner)
# =============================================================================
#
# ALIGNMENT:
# - requirement-shell-cli-interface.md
# - requirement-domain-take-ownership.md (about domain fields)
# - requirement-shell-cli-storage.md
#
# Last reviewed: 2026-08-30
# =============================================================================
app_about() {
    : "${JSON:=0}"
    : "${QUIET:=0}"
    : "${APP_NAME:=take-ownership}"
    : "${VERSION:=1.8.0}"
    : "${REPO_USER:=cloudgen}"
    : "${REPO_NAME:=take-ownership}"
    : "${SCRIPT_URL:=}"
    : "${GLOBAL_BIN:=/usr/local/bin}"
    : "${HOME:=/tmp}"
    : "${USER_BIN:=${HOME}/.local/bin}"
    : "${USERNAME:=unknown}"
    : "${XDG_CACHE_HOME:=${HOME}/.cache}"

    if [ -z "${EFFECTIVE_STORAGE_DIR:-}" ]; then
        EFFECTIVE_STORAGE_DIR=$(util_resolve_storage)
    fi
    if [ -z "${PERSIST_DIR:-}" ] || [ ! -d "${PERSIST_DIR}" ]; then
        PERSIST_DIR=$(util_resolve_persist)
        export PERSIST_DIR
    fi
    _cache_preferred=$(util_preferred_cache_dir)
    _cache_fallback=$(util_fallback_cache_dir)
    : "${STORAGE_DIR:=${_cache_fallback}}"
    _persist_dir=$(util_persist_dir)

    _installed="false"
    inst_is_installed && _installed="true"

    _global_ver="not found"
    if [ -x "${GLOBAL_BIN}/${APP_NAME}" ]; then
        _global_ver=$(grep '^VERSION="' "${GLOBAL_BIN}/${APP_NAME}" 2>/dev/null | cut -d'"' -f2 || echo "unknown")
    fi
    _local_ver="not found"
    if [ -x "${USER_BIN}/${APP_NAME}" ]; then
        _local_ver=$(grep '^VERSION="' "${USER_BIN}/${APP_NAME}" 2>/dev/null | cut -d'"' -f2 || echo "unknown")
    fi
    _shell=$(util_get_current_shell)
    _user=$(id -un 2>/dev/null || echo "unknown")
    _interactive="false"
    [ "${TTY:-0}" -eq 1 ] && _interactive="true"

    _global_present="false"
    if [ -r "${GLOBAL_BIN}/${APP_NAME}" ] && [ -x "${GLOBAL_BIN}/${APP_NAME}" ]; then
        _global_present="true"
    fi

    _sudoer_cli="not_found"
    if _scli_path=$(to_detect_sudoer_cli); then
        _sudoer_cli="${_scli_path}"
    fi
    _sudoer_adm="absent"
    if _sadm_name=$(to_detect_sudoer_adm); then
        _sudoer_adm="${_sadm_name}"
    fi
    _sudoer_inbound="not_found"
    _sudoer_inbound_writable="false"
    if _sin_path=$(to_detect_sudoer_inbound); then
        _sudoer_inbound="${_sin_path}"
        if [ -w "${_sin_path}" ]; then
            _sudoer_inbound_writable="true"
        fi
    fi

    _host_sudoers_present="false"
    _host_sudoers_path=""
    if _hsp=$(to_probe_current_user_host_sudoers); then
        _host_sudoers_present="true"
        _host_sudoers_path="${_hsp}"
    fi

    if [ "${JSON}" -eq 1 ]; then
        out_json "about" "" \
            "app" "${APP_NAME}" \
            "version" "${VERSION}" \
            "repo_user" "${REPO_USER}" \
            "repo_name" "${REPO_NAME}" \
            "repository" "${REPO_USER}/${REPO_NAME}" \
            "script_url" "${SCRIPT_URL}" \
            "installed" "${_installed}" \
            "global_version" "${_global_ver}" \
            "local_version" "${_local_ver}" \
            "shell" "${_shell}" \
            "interactive" "${_interactive}" \
            "user" "${_user}" \
            "cache_preferred" "${_cache_preferred}" \
            "cache_fallback" "${_cache_fallback}" \
            "effective_storage" "${EFFECTIVE_STORAGE_DIR}" \
            "storage_dir" "${STORAGE_DIR}" \
            "persist_dir" "${_persist_dir}" \
            "global_bin" "${GLOBAL_BIN}/${APP_NAME}" \
            "global_bin_present" "${_global_present}" \
            "sudoers_trust_tier" "$(to_sudoers_trust_tier)" \
            "sudoer_cli" "${_sudoer_cli}" \
            "sudoer_adm" "${_sudoer_adm}" \
            "sudoer_inbound" "${_sudoer_inbound}" \
            "sudoer_inbound_writable" "${_sudoer_inbound_writable}" \
            "host_sudoers_present" "${_host_sudoers_present}" \
            "host_sudoers_path" "${_host_sudoers_path}"
        return 0
    fi

    [ "${QUIET}" -eq 1 ] && return 0

    out_info "$(util_app_ident) — About / Diagnostics"
    out_empty_line
    if [ "${_installed}" = "true" ]; then
        out_success "${APP_NAME} is properly installed."
    else
        out_warn "${APP_NAME} is NOT installed in a managed bin path."
        out_info "   Recommended: ${APP_NAME} install   (local copy → ${USER_BIN}/${APP_NAME})"
    fi
    out_empty_line
    out_info "Global install  (${GLOBAL_BIN}/${APP_NAME}):   ${_global_ver}"
    out_info "Local install   (${USER_BIN}/${APP_NAME}):    ${_local_ver}"
    _tier=$(to_sudoers_trust_tier)
    out_info "Sudoers trust tier: ${_tier}  (grant emit requires global ${GLOBAL_BIN}/${APP_NAME})"
    out_empty_line
    out_info "Repository:        ${REPO_USER}/${REPO_NAME}"
    if [ -n "${SCRIPT_URL}" ]; then
        out_info "Install channel:   ${SCRIPT_URL}"
    else
        out_info "Install channel:   (empty — local install only)"
    fi
    out_empty_line
    out_info "Current user:      ${_user}"
    if [ "$(id -u)" -eq 0 ]; then
        out_success "Execution context: root"
    else
        out_info "Execution context: normal user (grant emit + action after admin install)"
    fi
    out_empty_line
    out_info "Current shell:     ${_shell}"
    if [ "${TTY:-0}" -eq 1 ]; then
        out_info "TTY / Interactive: yes"
    else
        out_info "TTY / Interactive: no"
    fi
    out_empty_line
    out_info "Cache folder (preferred): ${_cache_preferred}"
    out_info "Cache folder (fallback):  ${_cache_fallback}"
    out_info "Persistence storage:      ${_persist_dir}"
    out_empty_line
    out_info "Global binary present: ${_global_present} (${GLOBAL_BIN}/${APP_NAME})"
    out_info "sudoer-cli:        ${_sudoer_cli}"
    out_info "sudoer-adm:        ${_sudoer_adm}"
    if [ "${_sudoer_inbound}" = "not_found" ]; then
        out_info "sudoer inbound:    not_found (preferred ${SUDOER_PUBLIC_ROOT:-/var/sudoer-cli}/sudoer-request)"
    else
        out_info "sudoer inbound:    ${_sudoer_inbound} (writable=${_sudoer_inbound_writable})"
    fi
    out_info "Host sudoers:      ${_host_sudoers_present} ${_host_sudoers_path}"
    out_empty_line
    out_info "Useful commands:"
    out_info "   ${APP_NAME} help            → Full usage"
    out_info "   ${APP_NAME} install         → Local install to ~/.local/bin"
    out_info "   sudo ${APP_NAME} install    → Global install (required before grant emit)"
    out_info "   ${APP_NAME} generate-sudoer-request --path <folder>"
    out_info "   ${APP_NAME} submit-sudoer-request --path <folder>"
