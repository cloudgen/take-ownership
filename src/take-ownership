# =============================================================================
# util_get_current_shell() - Detect current / parent shell name
# =============================================================================
#
# GENERAL PURPOSE:
# Returns a best-effort shell command name for diagnostics (about).
# Prefer parent shell when the current process is sh/dash/ash/the app itself.
#
# PRINTF EXCEPTION (class B – function return-via-stdout):
# Final printf '%s' "$shell" (and echo fallbacks inside $(…)) are data
# returns for capture by app_about — not product messages. Display uses out_*.
# See requirement-shell-output-requirements.md §2.1.1.
#
# !!! DO NOT MODIFY OR SIMPLIFY THIS FUNCTION !!!
# Nested functions are not portable POSIX; this must stay top-level.
#
# Last reviewed: 2026-07-12

util_get_current_shell() {
    local shell="unknown"
    shell=$(ps -p $$ -o comm= 2>/dev/null | tr -d '()' || echo "unknown")

    if [ "$shell" = "${APP_NAME}" ] || [ "$shell" = "sh" ] || \
       [ "$shell" = "dash" ] || [ "$shell" = "ash" ]; then
        local parent_pid
        parent_pid=$(ps -p $$ -o ppid= 2>/dev/null | tr -d ' ')
        if [ -n "$parent_pid" ]; then
            shell=$(ps -p "$parent_pid" -o comm= 2>/dev/null | tr -d '()' || echo "$shell")
        fi
    fi
    printf '%s' "$shell"
}



# =============================================================================
# util_resolve_running_path() - Absolute path of running ship unit (class B)
# =============================================================================
#
# GENERAL PURPOSE:
# Resolve the absolute path of the currently executing ship unit for local
# install source. Returns empty string when $0 is not a resolvable file
# (e.g. stdin pipe degradation).
#
# PRINTF EXCEPTION (class B): path data for $(…) capture only.
#
# ALIGNMENT:
# - requirement-shell-local-self-management.md
#
# Last reviewed: 2026-08-03
# =============================================================================
util_resolve_running_path() {
    : "${0:=}"
    _src="$0"
    _resolved=""

    case "$_src" in
        ""|sh|bash|dash|ash|zsh|ksh|*/sh|*/bash|*/dash|*/ash|*/zsh|*/ksh)
            if [ ! -f "$_src" ]; then
                printf '%s' ""
                return 0
            fi
            ;;
    esac

    if [ ! -f "$_src" ] && [ ! -L "$_src" ]; then
        printf '%s' ""
        return 0
    fi

    if command -v readlink >/dev/null 2>&1; then
        _resolved=$(readlink -f "$_src" 2>/dev/null || true)
        if [ -n "$_resolved" ] && [ -e "$_resolved" ]; then
            printf '%s' "$_resolved"
            return 0
        fi
    fi
    if command -v realpath >/dev/null 2>&1; then
        _resolved=$(realpath "$_src" 2>/dev/null || true)
        if [ -n "$_resolved" ] && [ -e "$_resolved" ]; then
            printf '%s' "$_resolved"
            return 0
        fi
    fi

    # Fallback: dirname/basename join
    _dir=$(CDPATH= cd -- "$(dirname -- "$_src")" 2>/dev/null && pwd)
    _base=$(basename -- "$_src")
    if [ -n "$_dir" ] && [ -f "${_dir}/${_base}" ]; then
        printf '%s' "${_dir}/${_base}"
        return 0
    fi
    printf '%s' ""
}

# =============================================================================
# inst_local_install() - Local copy install (no network)
# =============================================================================
#
# GENERAL PURPOSE:
# Copy the running ship unit to the privilege-correct bin path.
# Root → GLOBAL_BIN; non-root → USER_BIN. Idempotent unless FORCE/FORCE_REINSTALL.
#
# ALIGNMENT:
# - requirement-shell-local-self-management.md
# - requirement-shell-idempotency.md
#
# Mode SSOT for managed binary (shell ship unit needs world-read for non-owners).
# Do NOT use chmod +x alone after mktemp (0600|0111 → 0711 breaks multi-user exec).
INST_MANAGED_MODE="0755"

# Last reviewed: 2026-08-09 — mode 0755 multi-user (requirement-shell-local-self-management §2.3.1)
# =============================================================================
inst_local_install() {
    : "${APP_NAME:=take-ownership}"
    : "${HOME:=/tmp}"
    : "${GLOBAL_BIN:=/usr/local/bin}"
    : "${USER_BIN:=${HOME}/.local/bin}"
    : "${FORCE:=0}"
    : "${FORCE_REINSTALL:=0}"
    : "${FORCE_GLOBAL:=0}"
    : "${JSON:=0}"
    : "${QUIET:=0}"
    : "${INST_MANAGED_MODE:=0755}"

    if [ "$(id -u 2>/dev/null || echo 1)" -eq 0 ]; then
        IS_ROOT=1
    else
        IS_ROOT=0
    fi
    : "${IS_ROOT:=0}"

    # Root or --global / FORCE_GLOBAL → system-wide path (production elevation story).
    if [ "${FORCE_GLOBAL}" -eq 1 ] || [ "${IS_ROOT}" -eq 1 ]; then
        _target_dir="${GLOBAL_BIN}"
    else
        _target_dir="${USER_BIN}"
    fi
    _target="${_target_dir}/${APP_NAME}"
    INSTALL_PATH="${_target}"

    if [ -x "${_target}" ] || [ -f "${_target}" ]; then
        if [ "${FORCE}" -eq 0 ] && [ "${FORCE_REINSTALL}" -eq 0 ]; then
            # Mode heal: prior chmod +x after mktemp left 0711/0700; keep multi-user runnable.
            chmod "${INST_MANAGED_MODE}" "${_target}" 2>/dev/null || true
            out_success "${APP_NAME} already installed at ${_target}"
            if [ "${_target_dir}" = "${USER_BIN}" ] && [ "${JSON}" -eq 0 ]; then
                out_warn "Local install is fine for Type 0 use. For durable sudoers, prefer: sudo ${APP_NAME} install  (global ${GLOBAL_BIN})"
            fi
            if [ "${JSON}" -eq 1 ]; then
                out_json "install" "already installed" \
                    "app" "${APP_NAME}" \
                    "path" "${_target}" \
                    "status" "already_installed" \
                    "mode" "${INST_MANAGED_MODE}"
            fi
            return 0
        fi
    fi

    _src=$(util_resolve_running_path)
    if [ -z "${_src}" ] || [ ! -f "${_src}" ]; then
        out_die "Cannot resolve running ship unit path for local install (not a file path)."
    fi

    if [ ! -d "${_target_dir}" ]; then
        if ! mkdir -p "${_target_dir}" 2>/dev/null; then
            if [ "${_target_dir}" = "${GLOBAL_BIN}" ]; then
                out_die "Cannot create ${GLOBAL_BIN} (need root). Run: sudo ${APP_NAME} install   or: sudo sh <ship-unit> install"
            fi
            out_die "Cannot create install directory ${_target_dir}"
        fi
    fi

    if [ ! -w "${_target_dir}" ] 2>/dev/null; then
        if [ "${_target_dir}" = "${GLOBAL_BIN}" ]; then
            out_die "Cannot write ${GLOBAL_BIN} (need root). Run: sudo ${APP_NAME} install   or: sudo sh <ship-unit> install --global"
        fi
        out_die "Install directory not writable: ${_target_dir}"
    fi

    _stage=$(mktemp "${EFFECTIVE_STORAGE_DIR:-/tmp}/${APP_NAME}.install.XXXXXX" 2>/dev/null || mktemp)
    if ! cp "${_src}" "${_stage}"; then
        rm -f "${_stage}" 2>/dev/null || true
        out_die "Failed to stage ship unit for install"
    fi
    # Absolute 0755 required: shell scripts need group/other *read* for non-owner exec.
    # chmod +x on a mktemp file (often 0600) yields 0711 — look executable, fail for others.
    if ! chmod "${INST_MANAGED_MODE}" "${_stage}"; then
        rm -f "${_stage}" 2>/dev/null || true
        out_die "Failed to chmod ${INST_MANAGED_MODE} staged ship unit"
    fi
    if ! mv -f "${_stage}" "${_target}"; then
        rm -f "${_stage}" 2>/dev/null || true
        out_die "Failed to install to ${_target}"
    fi
    # Re-assert mode after mv (some filesystems / policies may alter bits).
    if ! chmod "${INST_MANAGED_MODE}" "${_target}"; then
        out_die "Installed ${_target} but failed to set mode ${INST_MANAGED_MODE}"
    fi
    if [ ! -r "${_target}" ] || [ ! -x "${_target}" ]; then
        out_die "Installed ${_target} is not readable+executable (mode heal failed)"
    fi

    out_success "Installed ${APP_NAME} to ${_target}"
    if [ "${_target_dir}" = "${USER_BIN}" ]; then
        # Best-effort PATH integration for user bin (function, not external)
        path_add_shell 2>/dev/null || true
        if [ "${JSON}" -eq 0 ]; then
            out_warn "Local install is user-rewritable. Durable sudoers should use global install (root → ${GLOBAL_BIN})."
        fi
    fi
    if [ "${JSON}" -eq 1 ]; then
        out_json "install" "installed" \
            "app" "${APP_NAME}" \
            "path" "${_target}" \
            "status" "installed" \
            "mode" "${INST_MANAGED_MODE}"
    fi
    return 0
}

# =============================================================================
# inst_local_uninstall() - Local remove managed binary only
# =============================================================================
#
# GENERAL PURPOSE:
# Remove the managed binary at the privilege-correct path. Confirm when
# interactive unless --force. Non-interactive without force fails closed.
# Does NOT delete host sudoers fragments or unrelated user data.
#
# ALIGNMENT:
# - requirement-shell-local-self-management.md
# - requirement-shell-interactive-vs-noninteractive.md
#
# Last reviewed: 2026-08-03
# =============================================================================
inst_local_uninstall() {
    : "${APP_NAME:=take-ownership}"
    : "${HOME:=/tmp}"
    : "${GLOBAL_BIN:=/usr/local/bin}"
    : "${USER_BIN:=${HOME}/.local/bin}"
    : "${FORCE:=0}"
    : "${JSON:=0}"
    : "${QUIET:=0}"
    : "${TTY:=0}"

    _target=$(util_get_install_bin_path)

    if [ ! -e "${_target}" ]; then
        out_success "${APP_NAME} is not installed (nothing to uninstall)"
        if [ "${JSON}" -eq 1 ]; then
            out_json "uninstall" "already absent" \
                "app" "${APP_NAME}" \
                "path" "${_target}" \
                "status" "already_uninstalled"
        fi
        return 0
    fi

    if [ "${FORCE}" -eq 0 ]; then
        if [ "${JSON}" -eq 1 ] || [ "${QUIET}" -eq 1 ] || [ "${TTY}" -eq 0 ]; then
            out_die "Uninstall requires confirmation. Re-run with --force in non-interactive mode."
        fi
        if ! prompt_yes_no "Remove managed binary ${_target}?"; then
            out_info "Uninstall cancelled"
            return 0
        fi
    fi

    if ! rm -f "${_target}"; then
        out_die "Failed to remove ${_target}"
    fi
    out_success "Removed ${APP_NAME} from ${_target}"
    _installed=$(to_default_installed_sudoers_path)
    if [ "${JSON}" -eq 0 ]; then
        out_warn "Uninstall does not remove host sudoers fragments under /etc/sudoers.d/."
        out_info "If elevation was test-mode only, admin should uninstall soon: sudo rm ${_installed}"
        out_info "Multi-user: other users keep their own /etc/sudoers.d/${APP_NAME}-<user> fragments."
    fi
    if [ "${JSON}" -eq 1 ]; then
        out_json "uninstall" "removed" \
            "app" "${APP_NAME}" \
            "path" "${_target}" \
            "status" "uninstalled" \
            "sudoers_note" "does not remove /etc/sudoers.d/${APP_NAME}-<user>"
    fi
    return 0
}

# =============================================================================
# app_where_is_me() - Report running + install paths
# =============================================================================
#
# ALIGNMENT:
# - requirement-shell-local-self-management.md
#
# Last reviewed: 2026-08-03
# =============================================================================
app_where_is_me() {
    : "${APP_NAME:=take-ownership}"
    : "${JSON:=0}"
    : "${QUIET:=0}"

    _running=$(util_resolve_running_path)
    _install=$(util_get_install_bin_path)
    _installed="false"
    if [ -x "${_install}" ]; then
        _installed="true"
    fi

    if [ "${JSON}" -eq 1 ]; then
        out_json "where-is-me" "" \
            "app" "${APP_NAME}" \
            "running_path" "${_running:-}" \
            "install_path" "${_install}" \
            "installed" "${_installed}"
        return 0
    fi

    if [ -n "${_running}" ]; then
        out_info "Running path:  ${_running}"
    else
        out_warn "Running path:  (unresolvable — not a file path / pipe?)"
    fi
    out_info "Install path:  ${_install}"
    if [ "${_installed}" = "true" ]; then
        out_success "Installed:     yes"
    else
        out_info "Installed:     no"
    fi
}

# =============================================================================
# Domain helpers (to_*) — take-ownership
# ALIGNMENT:
# - requirement-domain-take-ownership.md
# - requirement-take-ownership-ops.md
# - requirement-shell-sudo-command.md
# Specialized from folder-backup Type 0; do not reverse-copy onto A.
# =============================================================================

# =============================================================================
# util_sudo() - Only in-tool sudo call site
# =============================================================================
#
# GENERAL PURPOSE:
# Wrap every in-tool sudo. Already-root runs the command without sudo.
#
# ALIGNMENT: requirement-shell-sudo-command.md
# Last updated: 2026-08-26
# =============================================================================
util_sudo() {
    if [ "$(id -u 2>/dev/null || echo 1)" -eq 0 ]; then
        "$@"
        return $?
    fi
    command -v sudo >/dev/null 2>&1 || return 1
    sudo "$@"
}

# =============================================================================
# util_chmod() - chmod with check-before-sudo
# =============================================================================
#
# ALIGNMENT: requirement-shell-sudo-command.md
# Last updated: 2026-08-26
# =============================================================================
util_chmod() {
    _mode="${1:-}"
    _path="${2:-}"
    [ -n "${_mode}" ] && [ -n "${_path}" ] || return 1
    [ -e "${_path}" ] || return 1
    if [ -O "${_path}" ]; then
        chmod "${_mode}" "${_path}"
        return $?
    fi
    util_sudo chmod "${_mode}" "${_path}"
}

# =============================================================================
# to_require_absolute_path() - Normalize --path; fail closed if relative or *
# =============================================================================
#
# ALIGNMENT: requirement-take-ownership-ops.md §2.1 / §2.3
# Last updated: 2026-08-26
# =============================================================================
to_require_absolute_path() {
    _p="${1:-}"
    if [ -z "${_p}" ]; then
        return 1
    fi
    case "${_p}" in
        \*|*\*\*)
            return 1
            ;;
        /*)
            ;;
        *)
            return 1
            ;;
    esac
    while [ "${#_p}" -gt 1 ]; do
        case "${_p}" in
            */) _p="${_p%/}" ;;
            *) break ;;
        esac
    done
    case "${_p}" in
        */../*|*/..|../*)
            return 1
            ;;
    esac
    printf '%s' "${_p}"
    return 0
}

# =============================================================================
# to_refuse_system_path() - Closed refuse list for --path
# =============================================================================
#
# ALIGNMENT: requirement-take-ownership-ops.md §2.3
# Last updated: 2026-08-26
# =============================================================================
to_refuse_system_path() {
    _p="${1:-}"
    # Ram-drive project trees (policy-ram-drive-first): /dev/shm/<basename>[/...]
    # is a workspace root, not a device node. Allow those children.
    # Still refuse /dev, /dev/shm (the mount root), and other /dev/* device paths.
    case "${_p}" in
        /dev/shm/*)
            return 1
            ;;
        /|/boot|/boot/*|/bin|/bin/*|/sbin|/sbin/*|/usr|/usr/*|/etc|/etc/*|/lib|/lib/*|/lib64|/lib64/*|/proc|/proc/*|/sys|/sys/*|/dev|/dev/*|/run|/run/*|/root|/root/*)
            return 0
            ;;
    esac
    return 1
}

# =============================================================================
# to_validate_ownership() - user:group must exist
# =============================================================================
#
# ALIGNMENT: requirement-take-ownership-ops.md §2.4
# Last updated: 2026-08-26
# =============================================================================
to_validate_ownership() {
    _og="${1:-}"
    case "${_og}" in
        ''|'*')
            return 1
            ;;
        *:*)
            ;;
        *)
            return 1
            ;;
    esac
    _u="${_og%%:*}"
    _g="${_og#*:}"
    case "${_g}" in
        *:*)
            return 1
            ;;
    esac
    if [ -z "${_u}" ] || [ -z "${_g}" ]; then
        return 1
    fi
    if ! id -u "${_u}" >/dev/null 2>&1; then
        return 1
    fi
    if command -v getent >/dev/null 2>&1; then
        if getent group "${_g}" >/dev/null 2>&1; then
            return 0
        fi
        return 1
    fi
    if id -g "${_g}" >/dev/null 2>&1; then
        return 0
    fi
    grep -q "^${_g}:" /etc/group 2>/dev/null
}

# =============================================================================
# to_fence_ownership_operand() - Fail closed on * / glob names / missing user:group
# =============================================================================
#
# ALIGNMENT: requirement-incorrect-ownership-parameter.md
# Last updated: 2026-08-26
# =============================================================================
to_fence_ownership_operand() {
    _og="${1:-}"
    _ctx="${2:-ownership}"
    : "${APP_NAME:=take-ownership}"
    case "${_og}" in
        ''|'*')
            out_die "--ownership must be an existing user:group (example www-data:www-data). Wildcard * is not allowed. You passed: ${_og:-empty}. Next: ${APP_NAME} ${_ctx} --path <folder> --ownership user:group"
            ;;
    esac
    case "${_og}" in
        *:*)
            ;;
        *)
            out_die "--ownership must be user:group, not a filename or glob. You passed: ${_og}. Next: ${APP_NAME} ${_ctx} --path <folder> --ownership user:group"
            ;;
    esac
    if ! to_validate_ownership "${_og}"; then
        out_die "--ownership must be an existing host user:group (example www-data:www-data). You passed: ${_og}"
    fi
    return 0
}

# =============================================================================
# to_stat_owner_group() - Class B: user:group of one inode
# =============================================================================
to_stat_owner_group() {
    _p="${1:-}"
    [ -n "${_p}" ] || return 1
    _og=$(stat -c '%U:%G' "${_p}" 2>/dev/null || true)
    if [ -z "${_og}" ]; then
        _og=$(stat -f '%Su:%Sg' "${_p}" 2>/dev/null || true)
    fi
    [ -n "${_og}" ] || return 1
    printf '%s' "${_og}"
}

# =============================================================================
# to_tree_already_owned() - 0 when every walked file/dir/link matches
# =============================================================================
#
# ALIGNMENT: requirement-take-ownership-ops.md §2.5
# Last updated: 2026-08-26
# =============================================================================
to_tree_already_owned() {
    _p="${1:-}"
    _want="${2:-}"
    [ -n "${_p}" ] && [ -n "${_want}" ] || return 1
    _root=$(to_stat_owner_group "${_p}") || return 1
    if [ "${_root}" != "${_want}" ]; then
        return 1
    fi
    # -P: do not follow symlinks (GNU and BSD find)
    if find -P "${_p}" \( -type f -o -type d -o -type l \) -print 2>/dev/null | {
        _bad=0
        while IFS= read -r _f; do
            [ -n "${_f}" ] || continue
            _og=$(to_stat_owner_group "${_f}") || { _bad=1; break; }
            if [ "${_og}" != "${_want}" ]; then
                _bad=1
                break
            fi
        done
        [ "${_bad}" -eq 0 ]
    }; then
        return 0
    fi
    return 1
}

# =============================================================================
# to_chown_recursive() - Recursive chown; do not follow symlinks
# =============================================================================
#
# ALIGNMENT: requirement-take-ownership-ops.md §2.5
# Last updated: 2026-08-26
# =============================================================================
to_chown_recursive() {
    _p="${1:-}"
    _og="${2:-}"
    [ -n "${_p}" ] && [ -n "${_og}" ] || return 1
    if chown -h -R "${_og}" "${_p}" 2>/dev/null; then
        return 0
    fi
    chown -R "${_og}" "${_p}"
}

# =============================================================================
# to_current_login_ownership() - Class B: id -un:id -gn of the grant subject
# =============================================================================
#
# ALIGNMENT: requirement-take-ownership-ops.md §2.2
# Last updated: 2026-08-30
# =============================================================================
to_current_login_ownership() {
    _u=$(to_grant_subject_user)
    _g=""
    if [ -n "${_u}" ]; then
        _g=$(id -gn "${_u}" 2>/dev/null || true)
    fi
    if [ -z "${_g}" ]; then
        _g=$(id -gn 2>/dev/null || true)
    fi
    if [ -z "${_u}" ] || [ -z "${_g}" ]; then
        return 1
    fi
    printf '%s:%s' "${_u}" "${_g}"
}

# =============================================================================
# to_prompt_allowed_folder_choice() - TTY numbered pick from list-folders set
# =============================================================================
#
# ALIGNMENT: requirement-take-ownership-ops.md §2.2
# Last updated: 2026-08-30
# =============================================================================
to_prompt_allowed_folder_choice() {
    : "${APP_NAME:=take-ownership}"
    _list=$(util_mktemp allowed-pick)
    to_emit_allowed_folders >"${_list}"
    _count=0
    while IFS= read -r _p; do
        [ -n "${_p}" ] || continue
        _count=$((_count + 1))
    done <"${_list}"
    if [ "${_count}" -eq 0 ]; then
        rm -f "${_list}"
        out_die "This login has no take-ownership folders yet. Next: ${APP_NAME} generate-sudoer-request --path <folder> --ownership user:group"
    fi
    out_info "Folders this login may take ownership of (${_count}):"
    _i=0
    while IFS= read -r _p; do
        [ -n "${_p}" ] || continue
        _i=$((_i + 1))
        out_plain "${_i}. ${_p}"
    done <"${_list}"

    while true; do
        if ! prompt_line "Choice"; then
            rm -f "${_list}"
            out_die "No folder chosen. Next: ${APP_NAME} action --path /var/www/html --ownership user:group"
        fi
        _pick="${_prompt_line}"
        case "${_pick}" in
            ''|0|q|Q|quit|QUIT|cancel|Cancel)
                rm -f "${_list}"
                out_die "No folder chosen. Next: ${APP_NAME} action --path /var/www/html --ownership user:group"
                ;;
        esac
        _chosen=""
        case "${_pick}" in
            *[!0-9]*)
                while IFS= read -r _p; do
                    if [ "${_p}" = "${_pick}" ]; then
                        _chosen="${_p}"
                        break
                    fi
                done <"${_list}"
                ;;
            *)
                if [ "${_pick}" -ge 1 ] && [ "${_pick}" -le "${_count}" ]; then
                    _i=0
                    while IFS= read -r _p; do
                        [ -n "${_p}" ] || continue
                        _i=$((_i + 1))
                        if [ "${_i}" -eq "${_pick}" ]; then
                            _chosen="${_p}"
                            break
                        fi
                    done <"${_list}"
                fi
                ;;
        esac
        if [ -n "${_chosen}" ]; then
            TO_PATH="${_chosen}"
            export TO_PATH
            rm -f "${_list}"
            return 0
        fi
        out_warn "Not a listed folder. Type a number 1-${_count}, or 0 to leave."
    done
}

# =============================================================================
# to_collect_missing_action_fields() - TTY pick or fail closed
# =============================================================================
#
# Interactive: numbered allowed-folder list; ownership is current user:group
# with no prompt. Non-interactive: fail closed (no hang).
#
# ALIGNMENT: requirement-take-ownership-ops.md §2.2 (Question 12b)
# Last updated: 2026-08-30
# =============================================================================
to_collect_missing_action_fields() {
    : "${TTY:=0}"
    : "${JSON:=0}"
    : "${TO_PATH:=}"
    : "${TO_OWNERSHIP:=}"
    : "${APP_NAME:=take-ownership}"
    if [ -z "${TO_PATH}" ]; then
        if [ "${TTY}" -eq 1 ] && [ "${JSON}" -ne 1 ]; then
            to_prompt_allowed_folder_choice
        fi
    fi
    if [ -z "${TO_OWNERSHIP}" ]; then
        if [ "${TTY}" -eq 1 ] && [ "${JSON}" -ne 1 ]; then
            TO_OWNERSHIP=$(to_current_login_ownership) || TO_OWNERSHIP=""
            export TO_OWNERSHIP
            if [ -n "${TO_OWNERSHIP}" ]; then
                out_info "Taking ownership as ${TO_OWNERSHIP}"
            fi
        fi
    fi
    if [ -z "${TO_PATH}" ]; then
        out_die "action needs --path <folder>. Next: ${APP_NAME} action --path /var/www/html --ownership www-data:www-data"
    fi
    if [ -z "${TO_OWNERSHIP}" ]; then
        out_die "action needs --ownership <user:group>. Next: ${APP_NAME} action --path ${TO_PATH} --ownership www-data:www-data"
    fi
}

# =============================================================================
# to_grant_subject_user() - Login whose grant we list (SUDO_USER after re-exec)
# =============================================================================
#
# ALIGNMENT: requirement-take-ownership-ops.md §2.5a
# Last updated: 2026-08-26
# =============================================================================
to_grant_subject_user() {
    if [ "$(id -u 2>/dev/null || echo 1)" -eq 0 ] && [ -n "${SUDO_USER:-}" ] && [ "${SUDO_USER}" != "root" ]; then
        printf '%s' "${SUDO_USER}"
        return 0
    fi
    to_current_login_user
}

to_home_for_login() {
    _u="${1:-}"
    _cur=$(id -un 2>/dev/null || echo "unknown")
    if [ -n "${_u}" ] && [ "${_u}" = "${_cur}" ]; then
        printf '%s' "${HOME}"
        return 0
    fi
    _h=""
    if [ -n "${_u}" ] && command -v getent >/dev/null 2>&1; then
        _h=$(getent passwd "${_u}" 2>/dev/null | cut -d: -f6)
    fi
    if [ -z "${_h}" ] && [ -n "${_u}" ] && [ -r /etc/passwd ]; then
        _h=$(awk -F: -v u="${_u}" '$1==u {print $6; exit}' /etc/passwd 2>/dev/null)
    fi
    if [ -n "${_h}" ] && [ -d "${_h}" ]; then
        printf '%s' "${_h}"
        return 0
    fi
    printf '%s' "${HOME}"
}

# =============================================================================
# to_extract_grant_paths_from_text() - Pull --path values from JSON or sudoers
# =============================================================================
#
# ALIGNMENT: requirement-take-ownership-ops.md §2.5a
# Last updated: 2026-08-26
# =============================================================================
to_extract_grant_paths_from_text() {
    awk '
    {
      line = $0
      while (match(line, /"--path",[[:space:]]*"[^"]+"/)) {
        s = substr(line, RSTART, RLENGTH)
        sub(/"--path",[[:space:]]*"/, "", s)
        sub(/"$/, "", s)
        if (s != "" && s != "*") print s
        line = substr(line, RSTART + RLENGTH)
      }
      line = $0
      while (match(line, /--path[[:space:]]+[^[:space:]]+/)) {
        s = substr(line, RSTART, RLENGTH)
        sub(/--path[[:space:]]+/, "", s)
        if (s != "" && s != "*") print s
        line = substr(line, RSTART + RLENGTH)
      }
    }'
}

to_append_grant_paths_from_file() {
    _gf="${1:-}"
    [ -n "${_gf}" ] && [ -r "${_gf}" ] || return 0
    to_extract_grant_paths_from_text <"${_gf}"
}

# =============================================================================
# to_emit_allowed_folders() - Unique absolute folders this login may take
# =============================================================================
#
# Sources (union, Type 0 readable): JSON grant, sudoers draft, installed
# fragment when readable, sudo -n -l when it prints this program's --path.
#
# ALIGNMENT: requirement-take-ownership-ops.md §2.5a
# Last updated: 2026-08-26
# =============================================================================
to_emit_allowed_folders() {
    : "${APP_NAME:=take-ownership}"
    : "${HOME:=/tmp}"
    : "${SUDOERS_D_DIR:=/etc/sudoers.d}"
    _user=$(to_grant_subject_user)
    _home=$(to_home_for_login "${_user}")
    _raw=$(util_mktemp allowed-raw)
    to_append_grant_paths_from_file "${_home}/.config/${APP_NAME}/sudoer-request-${_user}.json" >>"${_raw}"
    to_append_grant_paths_from_file "${_home}/.config/${APP_NAME}/sudoers.fragment-${_user}" >>"${_raw}"
    to_append_grant_paths_from_file "${_home}/.config/${APP_NAME}/sudoers.fragment" >>"${_raw}"
    to_append_grant_paths_from_file "${SUDOERS_D_DIR}/${APP_NAME}-${_user}" >>"${_raw}"
    to_append_grant_paths_from_file "${SUDOERS_D_DIR}/${APP_NAME}" >>"${_raw}"
    if [ "${SUDOERS_D_DIR}" = "/etc/sudoers.d" ] && command -v sudo >/dev/null 2>&1; then
        sudo -n -l 2>/dev/null | grep -F "${APP_NAME}" | to_extract_grant_paths_from_text >>"${_raw}" || true
    fi
    _out=$(util_mktemp allowed-out)
    while IFS= read -r _cand; do
        [ -n "${_cand}" ] || continue
        _norm=$(to_require_absolute_path "${_cand}" 2>/dev/null) || continue
        printf '%s\n' "${_norm}"
    done <"${_raw}" | awk 'NF && !seen[$0]++' | sort >"${_out}"
    cat "${_out}"
    rm -f "${_raw}" "${_out}"
}

to_folder_is_allowed() {
    _want="${1:-}"
    [ -n "${_want}" ] || return 1
    _list=$(util_mktemp allowed-check)
    to_emit_allowed_folders >"${_list}"
    _ok=1
    while IFS= read -r _p; do
        if [ "${_p}" = "${_want}" ]; then
            _ok=0
            break
        fi
    done <"${_list}"
    rm -f "${_list}"
    return "${_ok}"
}

to_require_allowed_folder() {
    : "${APP_NAME:=take-ownership}"
    _folder="${1:-}"
    if to_folder_is_allowed "${_folder}"; then
        return 0
    fi
    _any=$(to_emit_allowed_folders | awk 'NF{c++; exit} END{print c+0}')
    if [ "${_any}" = "0" ]; then
        out_die "This login has no take-ownership folders yet. Next: ${APP_NAME} list-folders   then   ${APP_NAME} generate-sudoer-request --path ${_folder}"
    fi
    out_die "Folder ${_folder} is not in this login's take-ownership list. Next: ${APP_NAME} list-folders   or   ${APP_NAME} generate-sudoer-request --path ${_folder}"
}

# =============================================================================
# to_list_folders() - Type 0: list folders this login may take ownership of
# =============================================================================
#
# GENERAL PURPOSE:
# Print the union of --path values from this login's grant artifacts.
# Same set action uses before chown. Does not write /etc. Does not chown.
#
# ALIGNMENT:
# - requirement-domain-take-ownership.md
# - requirement-take-ownership-ops.md §2.5a
#
# Last updated: 2026-08-26
# =============================================================================
to_list_folders() {
    : "${APP_NAME:=take-ownership}"
    : "${JSON:=0}"
    _user=$(to_grant_subject_user)
    _list=$(util_mktemp allowed-list)
    to_emit_allowed_folders >"${_list}"
    _count=0
    _arr="["
    _sep=""
    while IFS= read -r _p; do
        [ -n "${_p}" ] || continue
        _count=$((_count + 1))
        _arr="${_arr}${_sep}\"$(util_json_escape "${_p}")\""
        _sep=","
    done <"${_list}"
    _arr="${_arr}]"

    if [ "${JSON}" -eq 1 ]; then
        out_json "list-folders" "ok" \
            "user" "${_user}" \
            "count" "${_count}" \
            "@folders" "${_arr}"
        rm -f "${_list}"
        return 0
    fi
    if [ "${_count}" -eq 0 ]; then
        out_info "No folders in this login's take-ownership grant."
        out_info "Next: ${APP_NAME} generate-sudoer-request --path /var/www/html"
        rm -f "${_list}"
        return 0
    fi
    out_success "Folders this login may take ownership of (${_count}):"
    while IFS= read -r _p; do
        [ -n "${_p}" ] || continue
        out_plain "  ${_p}"
    done <"${_list}"
    rm -f "${_list}"
    return 0
}

# =============================================================================
# to_action() - Recursively take ownership of a named folder
# =============================================================================
#
# GENERAL PURPOSE:
# Validate --path and --ownership, confirm --path is in list-folders, then
# chown -R without following symlinks. Interactive: numbered allowed-folder
# pick; ownership defaults to current user:group (no prompt). Non-root
# re-execs the global binary via sudo -n. Already-root chowns directly.
#
# ALIGNMENT:
# - requirement-take-ownership-ops.md
# - requirement-shell-sudo-command.md
# - requirement-three-layer-privilege-model.md
#
# Last updated: 2026-08-30
# =============================================================================
to_action() {
    : "${APP_NAME:=take-ownership}"
    : "${GLOBAL_BIN:=/usr/local/bin}"
    : "${JSON:=0}"
    : "${TO_PATH:=}"
    : "${TO_OWNERSHIP:=}"
    : "${TO_FLAG_ORDER_OK:=1}"

    if [ "${TO_FLAG_ORDER_OK}" != "1" ]; then
        out_die "action flags must be --path <folder> then --ownership <user:group> (that order). Swapped flags would not match the installed grant. Next: ${APP_NAME} action --path /var/www/html --ownership www-data:www-data"
    fi

    to_collect_missing_action_fields

    _path=$(to_require_absolute_path "${TO_PATH}") || out_die "--path must be an absolute directory (not relative, not *). You passed: ${TO_PATH}. Next: ${APP_NAME} action --path /var/www/html --ownership user:group"
    TO_PATH="${_path}"
    export TO_PATH

    if to_refuse_system_path "${TO_PATH}"; then
        out_die "Refusing to take ownership of system path ${TO_PATH}. Choose a project or data folder. Next: ${APP_NAME} action --path /var/www/html --ownership www-data:www-data"
    fi
    if command -v realpath >/dev/null 2>&1; then
        _phys=$(realpath "${TO_PATH}" 2>/dev/null || true)
        if [ -n "${_phys}" ] && to_refuse_system_path "${_phys}"; then
            out_die "Refusing to take ownership of system path ${_phys} (resolved from ${TO_PATH})."
        fi
    fi
    if [ -L "${TO_PATH}" ]; then
        out_die "--path is a symbolic link. Refusing to take ownership through a link: ${TO_PATH}"
    fi
    if [ ! -d "${TO_PATH}" ]; then
        out_die "--path is not an existing directory: ${TO_PATH}"
    fi
    to_fence_ownership_operand "${TO_OWNERSHIP}" "action"
    to_require_allowed_folder "${TO_PATH}"

    if to_tree_already_owned "${TO_PATH}" "${TO_OWNERSHIP}"; then
        if [ "${JSON}" -eq 1 ]; then
            out_json "action" "already matching" \
                "path" "${TO_PATH}" \
                "ownership" "${TO_OWNERSHIP}" \
                "changed" "false"
            return 0
        fi
        out_success "Already ${TO_OWNERSHIP}: ${TO_PATH}"
        return 0
    fi

    if [ "$(id -u 2>/dev/null || echo 1)" -eq 0 ]; then
        to_chown_recursive "${TO_PATH}" "${TO_OWNERSHIP}" || out_die "chown failed on ${TO_PATH}"
        if [ "${JSON}" -eq 1 ]; then
            out_json "action" "ok" \
                "path" "${TO_PATH}" \
                "ownership" "${TO_OWNERSHIP}" \
                "changed" "true"
            return 0
        fi
        out_success "Took ownership ${TO_OWNERSHIP} on ${TO_PATH}"
        return 0
    fi

    _gbin="${GLOBAL_BIN}/${APP_NAME}"
    if [ ! -x "${_gbin}" ]; then
        out_die "action needs the global program at ${_gbin} (local install is not used for elevation — that would be a security leak). Next: sudo ${APP_NAME} install   then   ${APP_NAME} generate-sudoer-request --path ${TO_PATH}"
    fi
    _json_pre=""
    if [ "${JSON}" -eq 1 ]; then
        _json_pre="--json"
    fi
    if [ -n "${_json_pre}" ]; then
        if util_sudo -n "${_gbin}" --json action --path "${TO_PATH}" --ownership "${TO_OWNERSHIP}"; then
            return 0
        fi
    else
        if util_sudo -n "${_gbin}" action --path "${TO_PATH}" --ownership "${TO_OWNERSHIP}"; then
            return 0
        fi
    fi
    out_die "Could not take ownership of ${TO_PATH} (no matching passwordless grant, or sudo failed). Next: ${APP_NAME} generate-sudoer-request --path ${TO_PATH}   then   ${APP_NAME} submit-sudoer-request"
}

# =============================================================================
# to_sudoers_trust_tier() - Classify managed-install trust for print-sudoers
# =============================================================================
#
# Prints one of: production | test_local | unmanaged
# production = executable global managed binary present
# test_local = only local user-bin managed binary
# unmanaged  = neither path executable
#
# ALIGNMENT: requirement-three-layer-privilege-model.md §2.3.1a
# =============================================================================
to_sudoers_trust_tier() {
    : "${APP_NAME:=take-ownership}"
    : "${HOME:=/tmp}"
    : "${GLOBAL_BIN:=/usr/local/bin}"
    : "${USER_BIN:=${HOME}/.local/bin}"

    # Shell ship unit needs read+execute for the classifying process. Mode 0711
    # is -x but not -r for non-owners → not a usable multi-user production install.
    if [ -r "${GLOBAL_BIN}/${APP_NAME}" ] && [ -x "${GLOBAL_BIN}/${APP_NAME}" ]; then
        printf '%s' "production"
        return 0
    fi
    if [ -r "${USER_BIN}/${APP_NAME}" ] && [ -x "${USER_BIN}/${APP_NAME}" ]; then
        printf '%s' "test_local"
        return 0
    fi
    printf '%s' "unmanaged"
    return 0
}

# =============================================================================
# to_sudoers_fragment_text() - Class B: emit draft sudoers text to stdout
# =============================================================================
#
# GENERAL PURPOSE:
# Build the sudoer-file text dual of to_sudoers_json_text (verbs plus sudoers *).
#
# ALIGNMENT:
# - requirement-sudoer-json-file.md 1.3.0
# - requirement-three-layer-privilege-model.md 1.11.0 AC-25
# - requirement-domain-folder-backup.md
# - INC-20260823-001 (verb-only exact-argv does not match backup <folder>)
#
# Last reviewed: 2026-08-23
# =============================================================================
to_require_grant_path() {
    : "${TTY:=0}"
    : "${JSON:=0}"
    : "${TO_PATH:=}"
    : "${APP_NAME:=take-ownership}"
    if [ -z "${TO_PATH}" ]; then
        if [ "${TTY}" -eq 1 ] && [ "${JSON}" -ne 1 ]; then
            prompt_line "Folder this grant will allow (absolute path)" || true
            TO_PATH="${_prompt_line}"
            export TO_PATH
        fi
    fi
    if [ -z "${TO_PATH}" ]; then
        out_die "This command needs --path <folder> (the folder the grant will allow). Next: ${APP_NAME} generate-sudoer-request --path /var/www/html"
    fi
    _gp=$(to_require_absolute_path "${TO_PATH}") || out_die "--path must be an absolute folder (not *). You passed: ${TO_PATH}"
    TO_PATH="${_gp}"
    export TO_PATH
    if [ -e "${TO_PATH}" ] && [ ! -d "${TO_PATH}" ]; then
        out_die "--path must be a folder (recursive take-ownership), not a file. You passed: ${TO_PATH}"
    fi
}

to_require_grant_ownership() {
    : "${TTY:=0}"
    : "${JSON:=0}"
    : "${TO_OWNERSHIP:=}"
    : "${APP_NAME:=take-ownership}"
    if [ -z "${TO_OWNERSHIP}" ]; then
        if [ "${TTY}" -eq 1 ] && [ "${JSON}" -ne 1 ]; then
            prompt_line "Unix user:group this grant will allow (example www-data:www-data; not *)" || true
            TO_OWNERSHIP="${_prompt_line}"
            export TO_OWNERSHIP
        fi
    fi
    if [ -z "${TO_OWNERSHIP}" ]; then
        out_die "This command needs --ownership <user:group> (the owner the grant will allow). Wildcard * is not allowed. Next: ${APP_NAME} generate-sudoer-json --path /var/www/html --ownership www-data:www-data"
    fi
    to_fence_ownership_operand "${TO_OWNERSHIP}" "generate-sudoer-json"
    export TO_OWNERSHIP
}

to_list_grant_paths() {
    : "${TO_PATH:=}"
    : "${SUBMIT_ACTION:=add}"
    _seen_file="${1:-}"
    _tmp=$(util_mktemp paths)
    # Replacement grant: one unique folder per line. Read prior --path
    # values (one submission each) and add this --path if it is new.
    if [ "${SUBMIT_ACTION}" = "update" ] && [ -n "${_seen_file}" ] && [ -f "${_seen_file}" ]; then
        # Compact JSON is one line; do not use greedy sed (that keeps only the last --path).
        to_extract_grant_paths_from_text <"${_seen_file}" >>"${_tmp}" 2>/dev/null || true
    fi
    printf '%s\n' "${TO_PATH}" >>"${_tmp}"
    awk 'NF && !seen[$0]++' "${_tmp}"
    rm -f "${_tmp}"
}

# sudoers(5): a raw ':' after NOPASSWD: starts another Tag_Spec. JSON args stay
# the live argv (user:group). Text dual MUST write user\:group.
to_sudoers_escape_operand() {
    printf '%s' "${1-}" | sed 's/\\/\\\\/g; s/:/\\:/g'
}

to_sudoers_fragment_text() {
    : "${APP_NAME:=take-ownership}"
    : "${HOME:=/tmp}"
    : "${GLOBAL_BIN:=/usr/local/bin}"
    : "${USER_BIN:=${HOME}/.local/bin}"
    : "${TO_PATH:=}"
    : "${TO_OWNERSHIP:=}"

    _user=$(id -un 2>/dev/null || echo "unknown")
    _tier=$(to_sudoers_trust_tier)
    _global_path="${GLOBAL_BIN}/${APP_NAME}"
    _local_path="${USER_BIN}/${APP_NAME}"
    _installed=$(to_default_installed_sudoers_path)
    _own="${TO_OWNERSHIP}"
    _own_esc=$(to_sudoers_escape_operand "${_own}")
    _purpose="Allow ${_user} to take ownership of ${TO_PATH} as ${_own}."

    _trust_banner="# Trust tier: production (global managed binary: ${_global_path})
# Residual: elevating action as root can chown that folder tree to the granted user:group.
# Does NOT elevate ${_local_path} (user-rewritable — security leak).
# Multi-user: install as ${_installed} (per-user suffix; do not overwrite other users)."

    printf '%s\n' "# Purpose: ${_purpose}"
    printf '%s\n' "# ${APP_NAME} — action --path <folder> --ownership <user:group> only (review before install)"
    printf '%s\n' "# Target user: ${_user}"
    printf '%s\n' "# Install: sudo install -m 0440 <this-file> ${_installed}"
    printf '%s\n' "# Validate: sudo visudo -c -f ${_installed}"
    printf '%s\n' "# Trust tier: ${_tier}"
    printf '%s\n' "${_trust_banner}"
    printf '%s\n' "#"
    printf '%s\n' "# Grant is the project command only. Does NOT elevate ${_local_path}."
    printf '%s\n' "# Does NOT allowlist chown/mkdir/cp/tar/rm/install/chmod."
    printf '%s\n' "# --ownership is an existing user:group. Wildcard * is not allowed. --path is exact."
    to_list_grant_paths "${1:-}" | while IFS= read -r _gp; do
        [ -n "${_gp}" ] || continue
        printf '%s ALL=(root) NOPASSWD: %s action --path %s --ownership %s\n' "${_user}" "${_global_path}" "${_gp}" "${_own_esc}"
        printf '%s ALL=(root) NOPASSWD: %s --json action --path %s --ownership %s\n' "${_user}" "${_global_path}" "${_gp}" "${_own_esc}"
    done
}

# =============================================================================
# to_sudoers_json_command_object() - one commands[] object (verb or --json twin)
# =============================================================================
#
# GENERAL PURPOSE:
# Compact JSON command object. $1 = bound --path. $2 = 0 verb-first, 1 --json first.
# Ownership operand is TO_OWNERSHIP (existing user:group). Never * and never cwd names.
#
# ALIGNMENT: requirement-sudoer-json-file.md §2.3 · requirement-incorrect-ownership-parameter.md
# Last updated: 2026-08-26
# =============================================================================
to_sudoers_json_command_object() {
    _gp="${1:-}"
    _json_first="${2:-0}"
    : "${APP_NAME:=take-ownership}"
    : "${GLOBAL_BIN:=/usr/local/bin}"
    : "${TO_OWNERSHIP:=}"
    _global_path="${GLOBAL_BIN}/${APP_NAME}"
    _own="${TO_OWNERSHIP}"
    if [ "${_json_first}" = "1" ]; then
        printf '%s' "{\"runas\":\"root\",\"tags\":[\"NOPASSWD\"],\"path\":\"${_global_path}\",\"args\":[\"--json\",\"action\",\"--path\",\"${_gp}\",\"--ownership\",\"${_own}\"]}"
    else
        printf '%s' "{\"runas\":\"root\",\"tags\":[\"NOPASSWD\"],\"path\":\"${_global_path}\",\"args\":[\"action\",\"--path\",\"${_gp}\",\"--ownership\",\"${_own}\"]}"
    fi
}

# =============================================================================
# to_sudoers_json_text() - Class B: emit JSON sudoer file to stdout
# =============================================================================
#
# GENERAL PURPOSE:
# JSON sudoer file (requirement-sudoer-json-file). action from SUBMIT_ACTION.
#
# ALIGNMENT: requirement-sudoer-json-file.md §2.3 (args verb plus *)
# Last reviewed: 2026-08-26
# =============================================================================
to_sudoers_json_text() {
    # Compact and pretty are the same grant (requirement-sudoer-json-file).
    to_sudoers_json_text_compact "$@"
}

# Compact one-line dual of to_sudoers_json_text (same grant).
to_sudoers_json_text_compact() {
    : "${APP_NAME:=take-ownership}"
    : "${GLOBAL_BIN:=/usr/local/bin}"
    : "${SUBMIT_ACTION:=add}"
    : "${TO_PATH:=}"

    _user=$(id -un 2>/dev/null || echo "unknown")
    _action="${SUBMIT_ACTION}"
    case "${_action}" in
        add|update) ;;
        *) _action="add" ;;
    esac
    _cmds=""
    _sep=""
    while IFS= read -r _gp; do
        [ -n "${_gp}" ] || continue
        _one="$(to_sudoers_json_command_object "${_gp}" 0)"
        _two="$(to_sudoers_json_command_object "${_gp}" 1)"
        _cmds="${_cmds}${_sep}${_one},${_two}"
        _sep=","
    done <<EOF
$(to_list_grant_paths "${1:-}")
EOF
    printf '%s\n' "{\"schema_version\":1,\"purpose\":\"Allow ${_user} to take ownership of ${TO_PATH}.\",\"username\":\"${_user}\",\"service\":\"${APP_NAME}\",\"action\":\"${_action}\",\"commands\":[${_cmds}]}"
}

# =============================================================================
# to_sudoers_refuse_forbidden_grant() - Fail closed on OS-tool sudoer files
# =============================================================================
#
# ALIGNMENT: requirement-sudoer-json-file.md §2.7 AC-7
# =============================================================================
to_sudoers_refuse_forbidden_grant() {
    _gf="${1:-}"
    : "${APP_NAME:=take-ownership}"
    : "${GLOBAL_BIN:=/usr/local/bin}"
    if [ -z "${_gf}" ] || [ ! -f "${_gf}" ]; then
        out_die "sudoer grant file missing"
    fi
    _gb=$(cat "${_gf}" 2>/dev/null || true)
    case "${_gb}" in
        *"/usr/bin/mkdir"*|*"/bin/mkdir"*|*"/usr/bin/cp"*|*"/bin/cp"*|*"/usr/bin/tar"*|*"/bin/tar"*|*"/bin/rm "*|*"/usr/bin/rm "*|*"/usr/bin/install"*|*"/usr/bin/chmod"*|*"/bin/chmod"*|*"/usr/bin/chown"*|*"/bin/chown"*|*".local/bin/${APP_NAME}"*)
            out_die "refusing sudoer grant with OS-tool commands or a user-bin path (need ${GLOBAL_BIN}/${APP_NAME} action --path <folder> --ownership <user:group> only)"
            ;;
    esac
    case "${_gb}" in
        *'"--path", "*"'*|*'"--path","*"'*)
            out_die "refusing sudoer grant with --path * (folder must be exact). Path: ${_gf}"
            ;;
    esac
    case "${_gb}" in
        *'"--ownership","*"'*|*'--ownership", "*"'*)
            out_die "refusing sudoer grant with --ownership * (wildcard is not allowed). Path: ${_gf}. Next: ${APP_NAME} generate-sudoer-json --path <folder> --ownership user:group"
            ;;
    esac
    return 0
}

# Fail closed unless args are exactly action --path F --ownership user:group plus --json twin.
# $2 = queued request id (optional). * and cwd listings must not pass.
to_sudoers_verify_grant_verbs() {
    _gf="${1:-}"
    _queued="${2:-}"
    : "${APP_NAME:=take-ownership}"
    : "${GLOBAL_BIN:=/usr/local/bin}"
    if [ -z "${_gf}" ] || [ ! -f "${_gf}" ]; then
        out_die "sudoer file missing (cannot verify the take-ownership grant)"
    fi
    _head="Sudoer file is incomplete"
    _tail="Path: ${_gf}."
    _next="Next: ${APP_NAME} generate-sudoer-json --path <folder> --ownership user:group   (or generate-sudoer-request)"
    if [ -n "${_queued}" ]; then
        _head="Queued sudo request is incomplete"
        _tail="Do not approve ${_queued}."
    fi
    _gb=$(cat "${_gf}" 2>/dev/null || true)
    _norm=$(printf '%s' "${_gb}" | tr -d ' \t\n\r')
    case "${_gb}" in
        *"${GLOBAL_BIN}/${APP_NAME}"*) ;;
        *) out_die "${_head}: it does not name ${GLOBAL_BIN}/${APP_NAME}. ${_tail}" ;;
    esac
    case "${_norm}" in
        *'"--ownership","*"'*|*'--ownership","*",'*)
            out_die "${_head}: --ownership * is not allowed (wildcard, or a directory listing from an expanded *). Use an existing user:group. ${_tail} ${_next}"
            ;;
    esac
    case "${_norm}" in
        *'"args":["action","--path",'*',"--ownership","'*:*'"]'*) ;;
        *) out_die "${_head}: args must be action --path <folder> --ownership <user:group> (not * and not extra filenames). ${_tail} ${_next}" ;;
    esac
    case "${_norm}" in
        *'"args":["--json","action","--path",'*',"--ownership","'*:*'"]'*) ;;
        *) out_die "${_head}: missing --json twin with --ownership <user:group>. ${_tail} ${_next}" ;;
    esac
    _ops=$(printf '%s\n' "${_norm}" | grep -o '"--ownership","[^"]*"' 2>/dev/null || true)
    if [ -z "${_ops}" ]; then
        out_die "${_head}: it does not include --ownership. ${_tail} ${_next}"
    fi
    while IFS= read -r _tok; do
        [ -n "${_tok}" ] || continue
        _val=${_tok#*'"--ownership","'}
        _val=${_val%'"'}
        case "${_val}" in
            *:*)
                ;;
            *)
                out_die "${_head}: --ownership must be user:group, not a filename or glob (${_val}). ${_tail} ${_next}"
                ;;
        esac
        if ! to_validate_ownership "${_val}"; then
            out_die "${_head}: --ownership ${_val} is not an existing host user:group. ${_tail} ${_next}"
        fi
    done <<EOF
${_ops}
EOF
    # One sudoers line = one folder. Unique --path count must equal the
    # number of action objects (each folder has one verb line; --json is twin).
    _paths=$(printf '%s\n' "${_norm}" | grep -o '"--path","[^"]*"' 2>/dev/null | sed 's/"--path",//;s/"//g' || true)
    _nuniq=$(printf '%s\n' "${_paths}" | awk 'NF && !seen[$0]++' | wc -l | tr -d ' ')
    _nact=$(printf '%s\n' "${_norm}" | grep -o '"args":\["action"' 2>/dev/null | wc -l | tr -d ' ')
    if [ -z "${_nuniq}" ] || [ "${_nuniq}" = "0" ]; then
        out_die "${_head}: grant must name one folder per line. ${_tail} ${_next}"
    fi
    if [ "${_nuniq}" != "${_nact}" ]; then
        out_die "${_head}: each folder needs its own sudoers line (one --path per action object). Do not put files or extra folders on one line. ${_tail} ${_next}"
    fi
    return 0
}

# When sudoer-cli is present, convert must still list both verbs.
# Returns 0 if convert kept both; 1 if sudoer-cli is absent (caller may skip).
to_sudoers_verify_sibling_convert() {
    _gf="${1:-}"
    : "${APP_NAME:=take-ownership}"
    _cli=""
    if _cli=$(to_detect_sudoer_cli); then
        :
    else
        return 1
    fi
    # Stub CLIs used in suite only implement add/update. Skip convert unless
    # help lists json-to-sudoers (real sudoer-cli).
    _help=$("${_cli}" help 2>/dev/null || true)
    case "${_help}" in
        *json-to-sudoers*) ;;
        *) return 1 ;;
    esac
    _outf=$(util_mktemp sudoer-conv)
    _cerr=$(util_mktemp sudoer-conv-err)
    if ! "${_cli}" json-to-sudoers --file "${_gf}" --out "${_outf}" >/dev/null 2>"${_cerr}"; then
        _emsg=$(cat "${_cerr}" 2>/dev/null || true)
        rm -f "${_outf}" "${_cerr}"
        case "${_emsg}" in
            *"well-known system binary"*|*"test-well-known-binary"*)
                # Isolated/test GLOBAL_BIN is user-rewritable; sibling 1.17+
                # correctly refuses convert. Skip — do not block generate.
                return 1
                ;;
        esac
        out_die "sudoer-cli json-to-sudoers failed for ${_gf}. The file is not safe to submit."
    fi
    rm -f "${_cerr}"
    _txt=$(cat "${_outf}" 2>/dev/null || true)
    rm -f "${_outf}"
    case "${_txt}" in
        *" ${APP_NAME} action"*|*"/${APP_NAME} action"*|*" ${APP_NAME} --json action"*|*"/${APP_NAME} --json action"*) ;;
        *) out_die "sudoer-cli convert dropped action from ${_gf}. Do not submit this file. Next: ${APP_NAME} generate-sudoer-request --path ${TO_PATH:-/var/www/html}" ;;
    esac
    case "${_txt}" in
        *"--path"*) ;;
        *) out_die "sudoer-cli convert dropped --path from ${_gf}. Do not submit this file." ;;
    esac
    return 0
}

# =============================================================================
# to_print_sudoers() - Emit narrow sudoers fragment (does NOT write /etc)
# =============================================================================
#
# ALIGNMENT:
# - requirement-domain-folder-backup.md
# - requirement-three-layer-privilege-model.md
# - requirement-folder-archive-backup.md (deposit + restore stage fetch)
#
# Last reviewed: 2026-08-14
# =============================================================================
to_print_sudoers() {
    : "${APP_NAME:=take-ownership}"
    : "${JSON:=0}"
    : "${QUIET:=0}"
    : "${HOME:=/tmp}"
    : "${GLOBAL_BIN:=/usr/local/bin}"
    : "${USER_BIN:=${HOME}/.local/bin}"
    : "${TO_PATH:=}"

    to_require_grant_path
    to_require_grant_ownership
    to_sudoers_require_emit_trust "print-sudoers"

    _user=$(id -un 2>/dev/null || echo "unknown")
    _out_path="${1:-}"
    _tier=$(to_sudoers_trust_tier)
    _global_path="${GLOBAL_BIN}/${APP_NAME}"

    _installed=$(to_default_installed_sudoers_path)
    _draft_default=$(to_default_project_sudoers_path)
    _fragment=$(to_sudoers_fragment_text)

    if [ -n "${_out_path}" ]; then
        _dir=$(dirname -- "${_out_path}")
        if [ ! -d "${_dir}" ]; then
            mkdir -p "${_dir}" || out_die "Cannot create ${_dir}"
        fi
        printf '%s\n' "${_fragment}" > "${_out_path}" || out_die "Cannot write ${_out_path}"
        _json_path="${_out_path}.json"
        to_sudoers_json_text > "${_json_path}" || out_die "Cannot write ${_json_path}"
        out_success "Wrote sudoers fragment to ${_out_path}"
        out_info "JSON sudoer file: ${_json_path}"
        out_info "Admin: sudo visudo -c -f ${_out_path}"
        out_info "Admin: sudo install -m 0440 ${_out_path} ${_installed}"
        if [ "${JSON}" -eq 1 ]; then
            out_json "print-sudoers" "written" \
                "path" "${_out_path}" \
                "user" "${_user}" \
                "installed_path" "${_installed}" \
                "grant_path" "${TO_PATH}" \
                "trust_tier" "${_tier}"
        fi
        return 0
    fi

    if [ "${JSON}" -eq 1 ]; then
        out_json "print-sudoers" "use human mode or path arg to capture fragment" \
            "user" "${_user}" \
            "grant_path" "${TO_PATH}" \
            "installed_path" "${_installed}" \
            "trust_tier" "${_tier}" \
            "hint" "${APP_NAME} print-sudoers --path ${TO_PATH} ${_draft_default}"
        return 0
    fi

    out_info "Sudoers fragment for user ${_user} → ${GLOBAL_BIN}/${APP_NAME} action --path ${TO_PATH} --ownership ${TO_OWNERSHIP} (trust_tier=${_tier})"
    out_info "Admin steps: review → visudo -c -f FILE → install -m 0440 FILE ${_installed}"
    out_empty_line
    out_plain "${_fragment}"
    out_empty_line
    out_info "Tip: ${APP_NAME} print-sudoers --path ${TO_PATH} ${_draft_default}"
    out_info "Admin script: ${APP_NAME} print-sudoers-install-script --path ${TO_PATH}"
}

# =============================================================================
# to_detect_sudoer_cli() - Class B: path of sudoer-cli, or fail
# =============================================================================
#
# GENERAL PURPOSE:
# Locate the sudoer-cli binary (env override, global bin, user bin, PATH).
# Does not claim the approval queues exist.
#
# ALIGNMENT:
# - requirement-domain-folder-backup.md
# - requirement-three-layer-privilege-model.md
#
# Last reviewed: 2026-08-14
# =============================================================================
to_detect_sudoer_cli() {
    : "${HOME:=/tmp}"
    : "${GLOBAL_BIN:=/usr/local/bin}"
    : "${USER_BIN:=${HOME}/.local/bin}"
    : "${SUDOER_CLI:=}"

    if [ -n "${SUDOER_CLI}" ]; then
        if [ -x "${SUDOER_CLI}" ]; then
            printf '%s' "${SUDOER_CLI}"
            return 0
        fi
        return 1
    fi
    if [ -x "${GLOBAL_BIN}/sudoer-cli" ]; then
        printf '%s' "${GLOBAL_BIN}/sudoer-cli"
        return 0
    fi
    if [ -x "${USER_BIN}/sudoer-cli" ]; then
        printf '%s' "${USER_BIN}/sudoer-cli"
        return 0
    fi
    _found=$(command -v sudoer-cli 2>/dev/null || true)
    if [ -n "${_found}" ] && [ -x "${_found}" ]; then
        printf '%s' "${_found}"
        return 0
    fi
    return 1
}

# =============================================================================
# to_detect_sudoer_adm() - Class B: sudoer-adm login if present
# =============================================================================
#
# GENERAL PURPOSE:
# Probe whether the least-privilege approver account exists (id).
# Account name defaults to sudoer-adm; override with SUDOER_ADM_USER.
#
# ALIGNMENT:
# - requirement-domain-folder-backup.md
# - requirement-three-layer-privilege-model.md
#
# Last reviewed: 2026-08-14
# =============================================================================
to_detect_sudoer_adm() {
    : "${SUDOER_ADM_USER:=sudoer-adm}"
    if id "${SUDOER_ADM_USER}" >/dev/null 2>&1; then
        printf '%s' "${SUDOER_ADM_USER}"
        return 0
    fi
    return 1
}

# =============================================================================
# to_detect_sudoer_inbound() - Class B: inbound approval dir if present
# =============================================================================
#
# GENERAL PURPOSE:
# Find the sibling public inbound (preferred /var/sudoer-cli/sudoer-request).
# Type 0 MUST NOT mkdir. Order: env override → public → F4 view → legacy.
#
# ALIGNMENT:
# - requirement-three-layer-privilege-model.md §2.3.3c (AC-16)
# - requirement-domain-folder-backup.md
#
# Last reviewed: 2026-08-15
# =============================================================================
to_detect_sudoer_inbound() {
    : "${SUDOER_ADM_USER:=sudoer-adm}"
    : "${SUDOER_QUEUE_INBOUND:=}"
    : "${SUDOER_APPROVAL_APP:=sudoer-cli}"
    : "${SUDOER_INBOUND_BASENAME:=sudoer-request}"
    : "${SUDOER_PUBLIC_ROOT:=/var/${SUDOER_APPROVAL_APP}}"

    if [ -n "${SUDOER_QUEUE_INBOUND}" ] && [ -d "${SUDOER_QUEUE_INBOUND}" ]; then
        printf '%s' "${SUDOER_QUEUE_INBOUND}"
        return 0
    fi

    _home=""
    if command -v getent >/dev/null 2>&1; then
        _home=$(getent passwd "${SUDOER_ADM_USER}" 2>/dev/null | cut -d: -f6)
    fi
    if [ -z "${_home}" ] && [ -r /etc/passwd ]; then
        _home=$(awk -F: -v u="${SUDOER_ADM_USER}" '$1==u {print $6; exit}' /etc/passwd 2>/dev/null)
    fi

    for _cand in \
        "${SUDOER_PUBLIC_ROOT}/${SUDOER_INBOUND_BASENAME}" \
        ${_home:+"${_home}/${SUDOER_INBOUND_BASENAME}"} \
        ${_home:+"${_home}/sudoer-approving"} \
        "/etc/${SUDOER_ADM_USER}/sudoer-approving" \
        "/home/${SUDOER_ADM_USER}/sudoer-approving"
    do
        if [ -n "${_cand}" ] && [ -d "${_cand}" ]; then
            printf '%s' "${_cand}"
            return 0
        fi
    done
    return 1
}

# =============================================================================
# to_sudoer_queue_root_from_inbound() - parent of real public inbound, or test override
# =============================================================================
# MUST NOT treat a legacy …/sudoer-approving parent as the public queue root.
# =============================================================================
to_sudoer_queue_root_from_inbound() {
    _in="${1:-}"
    [ -n "${_in}" ] || return 1
    _base=$(basename -- "${_in}")
    if [ -n "${SUDOER_QUEUE_INBOUND}" ] && [ "${_in}" = "${SUDOER_QUEUE_INBOUND}" ]; then
        dirname -- "${_in}"
        return 0
    fi
    if [ "${_base}" = "${SUDOER_INBOUND_BASENAME:-sudoer-request}" ]; then
        _real="${_in}"
        if command -v readlink >/dev/null 2>&1; then
            _resolved=$(readlink -f "${_in}" 2>/dev/null || true)
            [ -n "${_resolved}" ] && _real="${_resolved}"
        fi
        dirname -- "${_real}"
        return 0
    fi
    return 1
}

# =============================================================================
# to_sudoers_require_emit_trust() - Fail-closed unless production or test-allow
# =============================================================================
to_sudoers_require_emit_trust() {
    : "${APP_NAME:=take-ownership}"
    : "${GLOBAL_BIN:=/usr/local/bin}"
    _cmd="${1:-submit-sudoer-request}"
    _tier=$(to_sudoers_trust_tier)
    if [ "${_tier}" != "production" ]; then
        out_die "${_cmd} needs the global program at ${GLOBAL_BIN}/${APP_NAME}. A local copy under ~/.local/bin is never written into sudoers (that would be a security leak). Next: sudo ${APP_NAME} install   or   ${APP_NAME} install --global"
    fi
}

# =============================================================================
# to_generate_sudoer_request() - Type 0: write a local JSON grant you can verify
# =============================================================================
#
# GENERAL PURPOSE:
# Write this product's sudoer JSON to a local path (default under ~/.config),
# verify action --path --ownership user:group plus --json twin, and when sudoer-cli
# exists convert the file. Does not write /etc or inbound.
#
# ALIGNMENT:
# - requirement-three-layer-privilege-model.md §2.3.3d
# - requirement-sudoer-json-file.md
# - requirement-domain-take-ownership.md
# - INC-20260817-002 (operator-readable; incomplete JSON is not a standing class)
# - INC-20260823-002 (* must stay a sudoers operand, not a cwd listing)
#
# Last reviewed: 2026-08-26
# generate-sudoer-json is the same handler (test-purpose alias; gold JSON body).
# =============================================================================
to_generate_sudoer_request() {
    : "${APP_NAME:=take-ownership}"
    : "${JSON:=0}"
    : "${HOME:=/tmp}"
    : "${SUBMIT_ACTION:=add}"
    : "${SUBMIT_ACTION_EXPLICIT:=0}"
    : "${TO_PATH:=}"
    : "${COMMAND:=generate-sudoer-request}"
    _gen_verb="${COMMAND}"
    case "${_gen_verb}" in
        generate-sudoer-json|generate-sudoer-request) ;;
        *) _gen_verb="generate-sudoer-request" ;;
    esac

    to_require_grant_path
    to_require_grant_ownership
    _out_path="${1:-}"
    _user=$(id -un 2>/dev/null || echo "unknown")

    _host_path=""
    _host_present="false"
    if _host_path=$(to_probe_current_user_host_sudoers); then
        _host_present="true"
    else
        _host_path=""
    fi
    if [ "${SUBMIT_ACTION_EXPLICIT}" -ne 1 ]; then
        if [ "${_host_present}" = "true" ]; then
            SUBMIT_ACTION="update"
        else
            SUBMIT_ACTION="add"
        fi
    fi
    case "${SUBMIT_ACTION}" in
        add|update) ;;
        *) out_die "${_gen_verb} action must be add or update (got ${SUBMIT_ACTION})" ;;
    esac

    to_sudoers_require_emit_trust "${_gen_verb}"

    if [ -z "${_out_path}" ]; then
        _out_path=$(to_default_sudoer_request_path)
    fi
    case "${_out_path}" in
        /etc|/etc/*)
            out_die "${_gen_verb} refuses to write under /etc (Type 0). Use a path under \$HOME or /dev/shm."
            ;;
        /var/sudoer-cli|/var/sudoer-cli/*)
            out_die "${_gen_verb} does not write inbound. Write a local file, then: ${APP_NAME} submit-sudoer-request <path>"
            ;;
    esac
    if [ -e "${_out_path}" ] && [ -L "${_out_path}" ]; then
        out_die "refusing symlink dest: ${_out_path}"
    fi
    if [ -d "${_out_path}" ]; then
        out_die "generate dest is a directory: ${_out_path}"
    fi
    _dir=$(dirname -- "${_out_path}")
    if [ ! -d "${_dir}" ]; then
        mkdir -p "${_dir}" || out_die "Cannot create ${_dir}"
    fi

    to_sudoers_json_text_compact "${_out_path}" >"${_out_path}.new" || out_die "Cannot write ${_out_path}"
    mv "${_out_path}.new" "${_out_path}" || out_die "Cannot place ${_out_path}"
    chmod 0644 "${_out_path}" 2>/dev/null || true
    if [ ! -r "${_out_path}" ]; then
        out_die "generated sudoer file is not readable: ${_out_path}"
    fi
    to_sudoers_refuse_forbidden_grant "${_out_path}"
    to_sudoers_verify_grant_verbs "${_out_path}"

    _convert="skipped"
    if to_sudoers_verify_sibling_convert "${_out_path}"; then
        _convert="ok"
    fi

    if [ "${JSON}" -eq 1 ]; then
        out_json "${_gen_verb}" "written" \
            "path" "${_out_path}" \
            "readable" "true" \
            "verified" "true" \
            "convert_checked" "$([ "${_convert}" = "ok" ] && echo true || echo false)" \
            "action" "${SUBMIT_ACTION}" \
            "host_fragment_present" "${_host_present}" \
            "user" "${_user}"
        return 0
    fi

    out_success "Wrote verified sudoer file to ${_out_path}"
    _nfold=$(to_list_grant_paths "${_out_path}" | awk 'NF' | wc -l | tr -d ' ')
    out_info "Grant allows: ${APP_NAME} action --path <folder> --ownership ${TO_OWNERSHIP} (${_nfold} folder line(s); JSON action=${SUBMIT_ACTION})"
    out_info "This --path is ${TO_PATH}. One sudoers line per unique folder. Extra files on one line are not allowed."
    if [ "${_convert}" = "ok" ]; then
        out_info "Convert check: action --path still present after sudoer-cli json-to-sudoers"
    else
        out_info "Convert check: skipped (no sudoer-cli, or convert refused a non-system path). File still lists action --path."
    fi
    out_info "Review the file, then submit it:"
    out_info "   ${APP_NAME} submit-sudoer-request ${_out_path}"
}

# =============================================================================
# to_submit_sudoer_request() - Type 0: queue this product's sudoers for approval
# =============================================================================
#
# GENERAL PURPOSE:
# Detect sudoer-cli and sudoer-adm, emit (or accept) a self-scoped sudoers
# fragment, and submit it via sudoer-cli so a JSON request lands in the
# public inbound (/var/sudoer-cli/sudoer-request). Does not write /etc
# and does not mkdir inbound. Approver (sudoer-adm) still must approve.
# Default emit is the compact verified grant (same as generate-sudoer-request).
#
# ALIGNMENT:
# - requirement-domain-folder-backup.md
# - requirement-three-layer-privilege-model.md
# - requirement-sudoer-json-file.md (JSON grant body: PRJ_NAME only)
# - requirement-shell-cli-interface.md
#
# Last reviewed: 2026-08-17
# =============================================================================
to_submit_sudoer_request() {
    : "${APP_NAME:=take-ownership}"
    : "${JSON:=0}"
    : "${QUIET:=0}"
    : "${HOME:=/tmp}"
    : "${SUDOER_ADM_USER:=sudoer-adm}"
    : "${SUBMIT_PURPOSE:=}"
    : "${SUBMIT_ACTION:=add}"
    : "${SUBMIT_ACTION_EXPLICIT:=0}"
    : "${EFFECTIVE_STORAGE_DIR:=}"
    : "${TO_PATH:=}"

    _src_file="${1:-}"
    _user=$(id -un 2>/dev/null || echo "unknown")
    _purpose="${SUBMIT_PURPOSE}"
    if [ -z "${_purpose}" ]; then
        _purpose="Allow ${_user} to take ownership of ${TO_PATH:-a named folder}."
    fi

    _host_path=""
    _host_present="false"
    if _host_path=$(to_probe_current_user_host_sudoers); then
        _host_present="true"
    else
        _host_path=""
    fi
    _action_source="explicit"
    if [ "${SUBMIT_ACTION_EXPLICIT}" -ne 1 ]; then
        _action_source="detected"
        if [ "${_host_present}" = "true" ]; then
            SUBMIT_ACTION="update"
        else
            SUBMIT_ACTION="add"
        fi
    fi
    case "${SUBMIT_ACTION}" in
        add|update) ;;
        *) out_die "submit-sudoer-request action must be add or update (got ${SUBMIT_ACTION})" ;;
    esac

    if [ -n "${_src_file}" ]; then
        if [ ! -f "${_src_file}" ]; then
            out_die "sudoers file not found: ${_src_file}"
        fi
        if [ -L "${_src_file}" ]; then
            out_die "refusing symlink sudoers input: ${_src_file}"
        fi
        to_sudoers_refuse_forbidden_grant "${_src_file}"
        to_sudoers_verify_grant_verbs "${_src_file}"
    fi

    _cli=""
    if _cli=$(to_detect_sudoer_cli); then
        :
    else
        out_die "sudoer-cli not found (set SUDOER_CLI or install sudoer-cli to ${GLOBAL_BIN:-/usr/local/bin}/sudoer-cli). Submit is Type 0 compose — this CLI does not write /etc."
    fi

    _adm=""
    if _adm=$(to_detect_sudoer_adm); then
        :
    else
        out_die "sudoer-adm not found (id ${SUDOER_ADM_USER} failed). Ask an admin to run: sudo sudoer-cli setup"
    fi

    : "${SUDOER_PUBLIC_ROOT:=/var/${SUDOER_APPROVAL_APP:-sudoer-cli}}"
    _inbound=""
    if _inbound=$(to_detect_sudoer_inbound); then
        :
    else
        out_die "sudoer inbound queue not found (preferred ${SUDOER_PUBLIC_ROOT}/sudoer-request). Ask an admin to run: sudo sudoer-cli setup"
    fi
    if [ ! -w "${_inbound}" ]; then
        out_die "sudoer inbound not writable: ${_inbound}. Check mode 3773 on public inbound (owner ${_adm})."
    fi

    _tmp=""
    if [ -n "${_src_file}" ]; then
        if [ ! -f "${_src_file}" ]; then
            out_die "sudoers file not found: ${_src_file}"
        fi
        if [ -L "${_src_file}" ]; then
            out_die "refusing symlink sudoers input: ${_src_file}"
        fi
        _tmp="${_src_file}"
        _cleanup_tmp=0
    else
        to_require_grant_path
        to_require_grant_ownership
        to_sudoers_require_emit_trust "submit-sudoer-request"
        if [ -z "${EFFECTIVE_STORAGE_DIR}" ]; then
            EFFECTIVE_STORAGE_DIR=$(util_resolve_storage)
        fi
        _tmp=$(util_mktemp sudoer)
        to_sudoers_json_text_compact >"${_tmp}" || out_die "cannot write temp sudoer JSON ${_tmp}"
        _cleanup_tmp=1
    fi
    to_sudoers_refuse_forbidden_grant "${_tmp}"
    to_sudoers_verify_grant_verbs "${_tmp}"
    to_sudoers_verify_sibling_convert "${_tmp}" || true

    # Point sudoer-cli at the public queue root (parent of real inbound).
    # Do not export a legacy sudoer-approving parent as the public trio root.
    if _qr=$(to_sudoer_queue_root_from_inbound "${_inbound}"); then
        SUDOER_CLI_QUEUE_ROOT="${_qr}"
        export SUDOER_CLI_QUEUE_ROOT
        if [ -n "${SUDOER_QUEUE_INBOUND}" ] && [ "${_inbound}" = "${SUDOER_QUEUE_INBOUND}" ]; then
            LPU_HOME="${_qr}"
            export LPU_HOME
        fi
    fi

    _verb="add-sudoer-request"
    if [ "${SUBMIT_ACTION}" = "update" ]; then
        _verb="update-sudoer-request"
    fi

    _errf=$(util_mktemp sudoer-err)
    _out=""
    _rc=0
    if [ "${JSON}" -eq 1 ]; then
        _out=$("${_cli}" --json "${_verb}" --file "${_tmp}" --purpose "${_purpose}" --service "${APP_NAME}" 2>"${_errf}")
        _rc=$?
    else
        _out=$("${_cli}" "${_verb}" --file "${_tmp}" --purpose "${_purpose}" --service "${APP_NAME}" 2>"${_errf}")
        _rc=$?
    fi
    _err=$(cat "${_errf}" 2>/dev/null || true)
    rm -f "${_errf}"
    if [ "${_cleanup_tmp}" -eq 1 ]; then
        rm -f "${_tmp}"
    fi

    if [ "${_rc}" -ne 0 ]; then
        if [ -n "${_err}" ]; then
            out_die "sudoer-cli ${_verb} failed: ${_err}"
        fi
        out_die "sudoer-cli ${_verb} failed (exit ${_rc})"
    fi

    _rid=$(printf '%s\n' "${_out}" | sed -n 's/.*"request_id":"\([^"]*\)".*/\1/p')
    if [ -z "${_rid}" ]; then
        _rid=$(printf '%s\n' "${_out}" | sed -n 's/.*request_id=\([^[:space:]]*\).*/\1/p')
    fi

    # When inbound is readable, queued body MUST still be the exact grant
    # (action --path F --ownership user:group plus --json twin). Purpose text and
    # [OK] submitted are not completeness. INC-20260817-001 · INC-20260823-002.
    if [ -n "${_rid}" ] && [ -r "${_inbound}/${_rid}" ]; then
        to_sudoers_verify_grant_verbs "${_inbound}/${_rid}" "${_rid}"
    fi

    if [ "${JSON}" -eq 1 ]; then
        out_json "submit-sudoer-request" "submitted" \
            "request_id" "${_rid}" \
            "action" "${SUBMIT_ACTION}" \
            "action_source" "${_action_source}" \
            "host_fragment_present" "${_host_present}" \
            "host_fragment_path" "${_host_path}" \
            "service" "${APP_NAME}" \
            "user" "${_user}" \
            "sudoer_cli" "${_cli}" \
            "sudoer_adm" "${_adm}" \
            "inbound" "${_inbound}"
        return 0
    fi

    out_success "Submitted ${SUBMIT_ACTION} request via ${_cli}"
    if [ -n "${_rid}" ]; then
        out_info "request_id=${_rid}"
    fi
    if [ "${_host_present}" = "true" ]; then
        out_info "host_fragment=${_host_path}  (action=${SUBMIT_ACTION} ${_action_source})"
    else
        out_info "host_fragment=absent  (action=${SUBMIT_ACTION} ${_action_source})"
    fi
    out_info "inbound=${_inbound}  (approver: ${_adm})"
    out_info "This CLI did not write /etc. Approver must approve the request."
    return 0
}

# =============================================================================
# to_current_login_user() - Class B: invoking login name for path suffixes
# =============================================================================
to_current_login_user() {
    id -un 2>/dev/null || echo "unknown"
}

# =============================================================================
# to_default_project_sudoers_path() - Class B: default project-sudoers-file path
# =============================================================================
# Per-user draft: ${HOME}/.config/${APP_NAME}/sudoers.fragment-<user>
# Multi-user: each login keeps a distinct draft filename (not a shared basename).
# =============================================================================
to_default_project_sudoers_path() {
    : "${APP_NAME:=take-ownership}"
    : "${HOME:=/tmp}"
    _user=$(to_current_login_user)
    printf '%s' "${HOME}/.config/${APP_NAME}/sudoers.fragment-${_user}"
}

# Local verified JSON grant for generate-sudoer-request (not inbound).
to_default_sudoer_request_path() {
    : "${APP_NAME:=take-ownership}"
    : "${HOME:=/tmp}"
    _user=$(to_current_login_user)
    printf '%s' "${HOME}/.config/${APP_NAME}/sudoer-request-${_user}.json"
}

# =============================================================================
# to_default_installed_sudoers_path() - Class B: host /etc/sudoers.d path
# =============================================================================
# Per-user installed name: /etc/sudoers.d/${APP_NAME}-<user>
# Prevents multi-user admin installs from overwriting another user's fragment.
# =============================================================================
to_sudoers_d_dir() {
    : "${SUDOERS_D_DIR:=/etc/sudoers.d}"
    printf '%s' "${SUDOERS_D_DIR}"
}

to_default_installed_sudoers_path() {
    : "${APP_NAME:=take-ownership}"
    _user=$(to_current_login_user)
    printf '%s' "$(to_sudoers_d_dir)/${APP_NAME}-${_user}"
}

# =============================================================================
# to_legacy_installed_sudoers_path() - Class B: pre-user-suffix host path
# =============================================================================
to_legacy_installed_sudoers_path() {
    : "${APP_NAME:=take-ownership}"
    printf '%s' "$(to_sudoers_d_dir)/${APP_NAME}"
}

# =============================================================================
# to_list_project_sudoers_drafts() - Class B: list draft paths under config
# =============================================================================
# Emits one absolute path per line: legacy sudoers.fragment then sudoers.fragment-*.
# ALIGNMENT: term project-sudoers-file · multi-user remove-project-sudoers
# =============================================================================
to_list_project_sudoers_drafts() {
    : "${APP_NAME:=take-ownership}"
    : "${HOME:=/tmp}"
    _dir="${HOME}/.config/${APP_NAME}"
    if [ ! -d "${_dir}" ]; then
        return 0
    fi
    # Legacy un-suffixed draft (pre multi-user naming)
    if [ -f "${_dir}/sudoers.fragment" ]; then
        printf '%s\n' "${_dir}/sudoers.fragment"
    fi
    for _f in "${_dir}"/sudoers.fragment-*; do
        if [ -f "${_f}" ]; then
            case "${_f}" in
                *.json) continue ;;
            esac
            printf '%s\n' "${_f}"
        fi
    done
    return 0
}

# =============================================================================
# to_list_host_sudoers_fragments() - Class B: list readable host elev paths
# =============================================================================
# Lists /etc/sudoers.d/${APP_NAME} (legacy) and /etc/sudoers.d/${APP_NAME}-*
# when present (probe-only; Type 0 never deletes them).
# =============================================================================
to_list_host_sudoers_fragments() {
    : "${APP_NAME:=take-ownership}"
    _dir=$(to_sudoers_d_dir)
    _legacy=$(to_legacy_installed_sudoers_path)
    if [ -e "${_legacy}" ]; then
        printf '%s\n' "${_legacy}"
    fi
    for _f in "${_dir}"/"${APP_NAME}"-*; do
        if [ -e "${_f}" ]; then
            printf '%s\n' "${_f}"
        fi
    done
    return 0
}

# =============================================================================
# to_probe_current_user_host_sudoers() - Class B: this user's installed fragment
# =============================================================================
# Prefer per-user ${SUDOERS_D_DIR}/${APP_NAME}-<user>, then legacy unsuffixed.
# Other users' ${APP_NAME}-<other> files do not count.
# Type 0: test -e first (works when the dir is searchable). If the dir is
# 0750/unreadable, try sudo -n test -e (no password; miss → stay-honest absent).
# Prints the first existing path; exit 1 if none found.
# =============================================================================
to_host_sudoers_exists() {
    _hp="${1:-}"
    [ -n "${_hp}" ] || return 1
    if [ -e "${_hp}" ]; then
        return 0
    fi
    if command -v sudo >/dev/null 2>&1; then
        sudo -n test -e "${_hp}" >/dev/null 2>&1 && return 0
    fi
    return 1
}

to_probe_current_user_host_sudoers() {
    _per=$(to_default_installed_sudoers_path)
    _leg=$(to_legacy_installed_sudoers_path)
    if to_host_sudoers_exists "${_per}"; then
        printf '%s' "${_per}"
        return 0
    fi
    if [ "${_leg}" != "${_per}" ] && to_host_sudoers_exists "${_leg}"; then
        printf '%s' "${_leg}"
        return 0
    fi
    return 1
}

# =============================================================================
# to_default_sudoers_admin_script_path() - Class B: admin install script path
# =============================================================================
#
# Prefer /dev/shm (volatile, multi-user handoff); else EFFECTIVE_STORAGE_DIR /tmp.
# ALIGNMENT: term project-sudoers-file · requirement-three-layer-privilege-model
# =============================================================================
to_default_sudoers_admin_script_path() {
    : "${APP_NAME:=take-ownership}"
    _user=$(to_current_login_user)
    _name="${APP_NAME}-${_user}-sudoers-admin.sh"
    if [ -d "/dev/shm" ] && [ -w "/dev/shm" ]; then
        printf '%s' "/dev/shm/${_name}"
        return 0
    fi
    if [ -n "${EFFECTIVE_STORAGE_DIR:-}" ] && [ -d "${EFFECTIVE_STORAGE_DIR}" ] && [ -w "${EFFECTIVE_STORAGE_DIR}" ]; then
        printf '%s' "${EFFECTIVE_STORAGE_DIR}/${_name}"
        return 0
    fi
    printf '%s' "/tmp/${_name}"
    return 0
}

# =============================================================================
# to_print_sudoers_install_script() - Type 0: emit admin install/uninstall script
# =============================================================================
#
# GENERAL PURPOSE:
# 1) Refresh project-sudoers-file (draft) via to_print_sudoers
# 2) Write a shell script under /dev/shm (or temp) for an account WITH sudo
#    to install | uninstall | replace the fragment under /etc/sudoers.d/
# Does NOT write /etc itself.
#
# ALIGNMENT:
# - term project-sudoers-file
# - requirement-three-layer-privilege-model.md
#
# Last reviewed: 2026-08-09
# =============================================================================
to_print_sudoers_install_script() {
    : "${APP_NAME:=take-ownership}"
    : "${JSON:=0}"
    : "${QUIET:=0}"
    : "${HOME:=/tmp}"
    : "${TO_PATH:=}"

    to_require_grant_path
    to_require_grant_ownership
    _user=$(to_current_login_user)
    _draft=$(to_default_project_sudoers_path)
    _script_out="${1:-}"
    if [ -z "${_script_out}" ]; then
        _script_out=$(to_default_sudoers_admin_script_path)
    fi
    _installed=$(to_default_installed_sudoers_path)
    _legacy=$(to_legacy_installed_sudoers_path)
    _tier=$(to_sudoers_trust_tier)

    # Refresh project-sudoers-file first (same trust gate as print-sudoers)
    to_print_sudoers "${_draft}" || return $?

    _script_dir=$(dirname -- "${_script_out}")
    if [ ! -d "${_script_dir}" ]; then
        mkdir -p "${_script_dir}" || out_die "Cannot create ${_script_dir}"
    fi

    # Refuse writing admin script under /etc
    case "${_script_out}" in
        /etc/*|/etc)
            out_die "Refusing to write admin script under /etc (Type 0). Use /dev/shm or temp path."
            ;;
    esac

    cat > "${_script_out}" <<EOF
#!/bin/sh
# =============================================================================
# ${APP_NAME} — admin sudoers install / uninstall script
# Generated by: ${APP_NAME} print-sudoers-install-script
# Target user (fragment User lines): ${_user}
# Trust tier at generation: ${_tier}
# Project sudoers file (draft): ${_draft}
# Installed path (per-user): ${_installed}
# Legacy shared path (pre multi-user naming): ${_legacy}
#
# RUN AS ROOT (or via sudo), after switching to an account with sudo rights:
#   sudo sh ${_script_out} install     # visudo-check draft → install 0440
#   sudo sh ${_script_out} uninstall   # remove THIS user's installed fragment
#   sudo sh ${_script_out} replace     # uninstall then install (refresh host fragment)
#
# Multi-user: installed path includes the user suffix so install for user A
# does not overwrite /etc/sudoers.d/${APP_NAME}-B for user B.
# This script NEVER embeds passwords. Review draft before install.
# Type 0 CLI must not run this with residual agent power as a silent /etc write.
# =============================================================================
set -u

APP_NAME="${APP_NAME}"
PROJECT_SUDOERS_FILE="${_draft}"
INSTALLED_SUDOERS="${_installed}"
LEGACY_INSTALLED_SUDOERS="${_legacy}"
GEN_USER="${_user}"
GEN_TIER="${_tier}"

die() { printf '%s\\n' "ERROR: \$*" >&2; exit 1; }
info() { printf '%s\\n' "\$*"; }

require_root() {
    if [ "\$(id -u 2>/dev/null || echo 1)" -ne 0 ]; then
        die "Must run as root (e.g. sudo sh \$0 install). Current uid=\$(id -u)."
    fi
}

cmd_install() {
    require_root
    [ -f "\${PROJECT_SUDOERS_FILE}" ] || die "Missing project sudoers file: \${PROJECT_SUDOERS_FILE} — regenerate with: ${APP_NAME} print-sudoers \${PROJECT_SUDOERS_FILE}"
    if command -v visudo >/dev/null 2>&1; then
        visudo -c -f "\${PROJECT_SUDOERS_FILE}" || die "visudo -c failed on draft"
    else
        info "WARN: visudo not found; skipping syntax check (install carefully)"
    fi
    install -m 0440 -o root -g root "\${PROJECT_SUDOERS_FILE}" "\${INSTALLED_SUDOERS}" \\
        || die "install to \${INSTALLED_SUDOERS} failed"
    if command -v visudo >/dev/null 2>&1; then
        visudo -c -f "\${INSTALLED_SUDOERS}" || die "visudo -c failed on installed file — removing"
    fi
    info "OK: installed \${INSTALLED_SUDOERS} (mode 0440) from \${PROJECT_SUDOERS_FILE}"
    info "Fragment target user at generation: \${GEN_USER} (trust_tier=\${GEN_TIER})"
    info "Multi-user note: other users install to /etc/sudoers.d/\${APP_NAME}-<their-user> (no overwrite)"
    if [ -e "\${LEGACY_INSTALLED_SUDOERS}" ] && [ "\${LEGACY_INSTALLED_SUDOERS}" != "\${INSTALLED_SUDOERS}" ]; then
        info "WARN: legacy shared fragment still present: \${LEGACY_INSTALLED_SUDOERS}"
        info "      Consider admin review/remove if migrating to per-user names."
    fi
    if [ "\${GEN_TIER}" != "production" ]; then
        info "WARN: TEST MODE trust tier — plan uninstall soon: sudo sh \$0 uninstall"
    fi
}

cmd_uninstall() {
    require_root
    if [ ! -e "\${INSTALLED_SUDOERS}" ]; then
        info "OK: \${INSTALLED_SUDOERS} already absent (nothing to uninstall)"
    else
        rm -f "\${INSTALLED_SUDOERS}" || die "Failed to remove \${INSTALLED_SUDOERS}"
        info "OK: removed \${INSTALLED_SUDOERS}"
    fi
    if [ -e "\${LEGACY_INSTALLED_SUDOERS}" ] && [ "\${LEGACY_INSTALLED_SUDOERS}" != "\${INSTALLED_SUDOERS}" ]; then
        info "NOTE: legacy shared fragment still present: \${LEGACY_INSTALLED_SUDOERS}"
        info "      This script only removes the per-user path for \${GEN_USER}."
        info "      To remove legacy: sudo rm \${LEGACY_INSTALLED_SUDOERS}"
    fi
    if command -v visudo >/dev/null 2>&1; then
        visudo -c >/dev/null 2>&1 || info "WARN: visudo -c reported issues after remove (check other fragments)"
    fi
    info "Note: does not remove ${APP_NAME} binaries or other users' fragments"
}

cmd_replace() {
    cmd_uninstall
    cmd_install
}

cmd_status() {
    if [ -f "\${INSTALLED_SUDOERS}" ]; then
        info "installed: \${INSTALLED_SUDOERS}"
        ls -la "\${INSTALLED_SUDOERS}" 2>/dev/null || true
    else
        info "installed: (absent) \${INSTALLED_SUDOERS}"
    fi
    if [ -e "\${LEGACY_INSTALLED_SUDOERS}" ] && [ "\${LEGACY_INSTALLED_SUDOERS}" != "\${INSTALLED_SUDOERS}" ]; then
        info "legacy_installed: \${LEGACY_INSTALLED_SUDOERS}"
        ls -la "\${LEGACY_INSTALLED_SUDOERS}" 2>/dev/null || true
    fi
    # Sibling per-user fragments (multi-user host)
    for _sib in /etc/sudoers.d/\${APP_NAME}-*; do
        if [ -e "\${_sib}" ] && [ "\${_sib}" != "\${INSTALLED_SUDOERS}" ]; then
            info "other_user_fragment: \${_sib}"
        fi
    done
    if [ -f "\${PROJECT_SUDOERS_FILE}" ]; then
        info "draft: \${PROJECT_SUDOERS_FILE}"
        ls -la "\${PROJECT_SUDOERS_FILE}" 2>/dev/null || true
    else
        info "draft: (absent) \${PROJECT_SUDOERS_FILE}"
    fi
    info "generated_for_user=\${GEN_USER} trust_tier=\${GEN_TIER}"
}

usage() {
    cat <<U
Usage: sudo sh \$0 {install|uninstall|replace|status}
  install    visudo-check project sudoers file → install -m 0440 → per-user /etc/sudoers.d/
  uninstall  remove /etc/sudoers.d/${APP_NAME}-<user> for this script's user (leave elev)
  replace    uninstall then install (refresh host fragment from draft)
  status     show draft + installed presence (incl. legacy / other users if present)
Project sudoers file: \${PROJECT_SUDOERS_FILE}
Installed path:       \${INSTALLED_SUDOERS}
U
}

_action="\${1:-}"
case "\${_action}" in
    install)   cmd_install ;;
    uninstall) cmd_uninstall ;;
    replace)   cmd_replace ;;
    status)    cmd_status ;;
    -h|--help|help|"") usage; [ -n "\${_action}" ] || exit 1 ;;
    *) die "Unknown action: \${_action}"; usage; exit 1 ;;
esac
exit 0
EOF

    chmod 0750 "${_script_out}" 2>/dev/null || chmod +x "${_script_out}" 2>/dev/null || true

    out_success "Wrote admin sudoers script: ${_script_out}"
    out_info "Project sudoers file (draft): ${_draft}"
    out_info "Installed path (admin only, per-user): ${_installed}"
    out_empty_line
    out_info "Handoff — login as account with sudo, then:"
    out_plain "  sudo sh ${_script_out} install     # install/refresh THIS user's host fragment"
    out_plain "  sudo sh ${_script_out} uninstall   # remove THIS user's host fragment"
    out_plain "  sudo sh ${_script_out} replace     # uninstall then install"
    out_plain "  sudo sh ${_script_out} status"
    if [ "${_tier}" != "production" ]; then
        out_warn "TEST MODE trust_tier=${_tier}: after testing, admin should uninstall fragment soon."
    fi
    if [ "${JSON}" -eq 1 ]; then
        out_json "print-sudoers-install-script" "written" \
            "script_path" "${_script_out}" \
            "project_sudoers_file" "${_draft}" \
            "installed_path" "${_installed}" \
            "user" "${_user}" \
            "trust_tier" "${_tier}"
    fi
    return 0
}

# =============================================================================
# to_remove_project_sudoers() - Type 0: remove project-sudoers-file (draft only)
# =============================================================================
#
# GENERAL PURPOSE:
# Delete the product-owned project-sudoers-file draft(s). Default discovery lists
# drafts under ${HOME}/.config/${APP_NAME}/ (legacy sudoers.fragment +
# sudoers.fragment-<user>). When multiple drafts exist and no path arg is given,
# interactive mode lists them and lets the user choose; non-interactive requires
# an explicit path (or --force only when a single draft / current default).
# Never touches /etc/sudoers.d/. Confirm unless --force.
# Probes host installed path(s) and warns when elev is still active (honesty).
#
# ALIGNMENT:
# - term project-sudoers-file
# - requirement-three-layer-privilege-model.md §2.3.3b
#
# Last reviewed: 2026-08-09
# =============================================================================
to_remove_project_sudoers() {
    : "${APP_NAME:=take-ownership}"
    : "${HOME:=/tmp}"
    : "${FORCE:=0}"
    : "${JSON:=0}"
    : "${QUIET:=0}"
    : "${TTY:=0}"

    _path="${1:-}"
    _installed=$(to_default_installed_sudoers_path)
    _legacy=$(to_legacy_installed_sudoers_path)
    _default_draft=$(to_default_project_sudoers_path)
    _host_present=0
    _host_list=""
    _host_list=$(to_list_host_sudoers_fragments 2>/dev/null || true)
    if [ -n "${_host_list}" ]; then
        _host_present=1
    fi

    # --- Resolve which draft path to remove ---
    if [ -z "${_path}" ]; then
        _draft_list=$(to_list_project_sudoers_drafts 2>/dev/null || true)
        _count=0
        if [ -n "${_draft_list}" ]; then
            _count=$(printf '%s\n' "${_draft_list}" | grep -c . 2>/dev/null || echo 0)
        fi
        # normalize count (grep -c may leave trailing newline issues)
        _count=$(printf '%s' "${_count}" | tr -d '[:space:]')
        : "${_count:=0}"

        if [ "${_count}" -eq 0 ]; then
            _path="${_default_draft}"
        elif [ "${_count}" -eq 1 ]; then
            _path=$(printf '%s\n' "${_draft_list}" | head -n 1)
        else
            # Multiple drafts: list and choose (interactive) or fail closed with list
            out_info "Multiple project-sudoers-file drafts found under ${HOME}/.config/${APP_NAME}/:"
            _i=0
            # shellcheck disable=SC2039
            _indexed=""
            while IFS= read -r _line; do
                [ -n "${_line}" ] || continue
                _i=$((_i + 1))
                out_plain "  ${_i}) ${_line}"
                _indexed="${_indexed}${_i}|${_line}
"
            done <<EOF
${_draft_list}
EOF
            out_plain "  0) cancel"
            out_info "Pass an explicit path to remove one non-interactively, e.g.:"
            out_plain "  ${APP_NAME} remove-project-sudoers --force <path>"

            if [ "${JSON}" -eq 1 ] || [ "${QUIET}" -eq 1 ] || [ "${TTY}" -eq 0 ]; then
                out_die "remove-project-sudoers: multiple drafts present; specify path argument (non-interactive)."
            fi

            prompt_line "Choose draft number to remove" || true
            _choice="${_prompt_line:-0}"
            case "${_choice}" in
                ''|0|[Cc][Aa][Nn][Cc][Ee][Ll]*)
                    out_info "Remove cancelled"
                    return 0
                    ;;
                *[!0-9]*)
                    out_die "Invalid choice: ${_choice}"
                    ;;
            esac
            if [ "${_choice}" -lt 1 ] || [ "${_choice}" -gt "${_i}" ]; then
                out_die "Choice out of range: ${_choice} (1-${_i}, or 0 to cancel)"
            fi
            _path=$(printf '%s\n' "${_indexed}" | while IFS='|' read -r _n _p; do
                if [ "${_n}" = "${_choice}" ]; then
                    printf '%s' "${_p}"
                    break
                fi
            done)
            if [ -z "${_path}" ]; then
                out_die "Could not resolve choice ${_choice}"
            fi
        fi
    fi

    # Refuse removing under /etc as Type 0 (host elev is admin-only)
    case "${_path}" in
        /etc/*|/etc)
            out_die "Refusing to remove paths under /etc as Type 0. This command only deletes the user draft (project-sudoers-file). Host elev is admin-only: sudo rm ${_installed}  OR  ${APP_NAME} print-sudoers-install-script && sudo sh <script> uninstall"
            ;;
    esac

    _status=""
    if [ ! -e "${_path}" ]; then
        _status="already_absent"
        out_success "Project sudoers draft not present (nothing to remove): ${_path}"
    else
        if [ "${FORCE}" -eq 0 ]; then
            if [ "${JSON}" -eq 1 ] || [ "${QUIET}" -eq 1 ] || [ "${TTY}" -eq 0 ]; then
                out_die "remove-project-sudoers requires confirmation. Re-run with --force in non-interactive mode."
            fi
            if ! prompt_yes_no "Remove project-sudoers-file draft ${_path}?"; then
                out_info "Remove cancelled"
                return 0
            fi
        fi
        if ! rm -f "${_path}"; then
            out_die "Failed to remove ${_path}"
        fi
        _status="removed"
        out_success "Removed project-sudoers-file draft: ${_path}"
    fi

    # Honesty: draft and host elev are two layers (L-SUDOERS-03). Multi-user: list all present.
    if [ "${JSON}" -eq 0 ]; then
        if [ "${_host_present}" -eq 1 ]; then
            out_warn "Host elevation STILL ACTIVE (separate from draft):"
            printf '%s\n' "${_host_list}" | while IFS= read -r _hp; do
                [ -n "${_hp}" ] || continue
                out_plain "  ${_hp}"
            done
            out_info "remove-project-sudoers only deletes the user draft — never /etc/sudoers.d/."
            out_info "Admin leave elev (this user): sudo rm ${_installed}"
            if [ -e "${_legacy}" ] && [ "${_legacy}" != "${_installed}" ]; then
                out_info "Admin leave elev (legacy shared): sudo rm ${_legacy}"
            fi
            out_info "Or handoff script: ${APP_NAME} print-sudoers-install-script && sudo sh <script> uninstall"
        else
            out_info "Host fragment also absent (no elev at ${_installed}; no legacy ${_legacy})."
        fi
    else
        if [ "${_status}" = "removed" ]; then
            out_json "remove-project-sudoers" "removed" \
                "path" "${_path}" \
                "status" "removed" \
                "installed_path" "${_installed}" \
                "host_fragment_present" "${_host_present}" \
                "note" "does not remove /etc/sudoers.d fragment"
        else
            out_json "remove-project-sudoers" "already absent" \
                "path" "${_path}" \
                "status" "already_absent" \
                "installed_path" "${_installed}" \
                "host_fragment_present" "${_host_present}"
        fi
    fi
    return 0
}


